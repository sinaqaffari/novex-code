---
/* ==========================================================================
   نووکس‌کد — چیدمان صفحات فروش و مجله (Store Layout)
   هدر، پاورقی، سیستم طراحی مشترک، تگ‌های سئو.
   ========================================================================== */

import Header from '../components/store/Header.astro';
import Footer from '../components/store/Footer.astro';
import '../styles/store.css';

interface Props {
	title: string;
	description?: string;
	cartCount?: number;
	type?: 'website' | 'article';
	image?: string;
	publishedAt?: string;
	noindex?: boolean;
}

const {
	title,
	description = '',
	cartCount = 0,
	type = 'website',
	image,
	publishedAt,
	noindex = false,
} = Astro.props;
const path = Astro.url.pathname;
const origin = 'https://example.com';
const canonical = `${origin}${path}`;
---
<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<title>{title} | نووکس‌کد</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={type} />
		<meta property="og:locale" content="fa_IR" />
		<meta property="og:url" content={canonical} />
		{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
		{image && <meta property="og:image" content={image} />}
	</head>
	<body class="store">
		<a class="sr-only" href="#main">پرش به محتوای اصلی</a>

		<Header cartCount={cartCount} />

		<main id="main" class="container">
			<slot />
		</main>

		<Footer />
	</body>
</html>

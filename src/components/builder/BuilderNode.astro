---
import type { BuilderNode } from '../../lib/builder/types.ts';
import { controlledNodeStyle } from '../../lib/builder/render.ts';
import ProductGrid from './ProductGrid.astro';
import { parseBuilderMediaReference, resolveBuilderImageSource } from '../../lib/builder/media-reference.ts';
import { assetExists } from '../../lib/cms/media.ts';

interface Props {
	node: BuilderNode;
}

const { node } = Astro.props;
const style = controlledNodeStyle(node.styles);
const id = node.id;
const baseClass = `nvx-builder-node${node.styles?.width ? ` nvx-builder-node--width-${node.styles.width}` : ''}`;
const mediaReference = node.type === 'Image' ? parseBuilderMediaReference(node.props.src) : null;
const mediaPath = mediaReference ? `${mediaReference.bucket === 'uploads' ? 'uploads/' : ''}${mediaReference.name}` : '';
const imageAvailable = node.type === 'Image' && mediaReference ? await assetExists(mediaPath) : true;
const imageSource = node.type === 'Image' ? resolveBuilderImageSource(node.props.src) : '';
---

{node.type === 'Container' ? (
	<div
		class:list={[baseClass, 'nvx-builder-container', `nvx-builder-container--${node.props.background}`]}
		data-builder-id={id}
		data-layout={node.props.layout}
		data-max-width={node.props.maxWidth}
		style={`gap:${node.props.gap}px;padding:${node.props.padding}px${style ? `;${style}` : ''}`}
	>
		{node.children.map((child) => <Astro.self node={child} />)}
	</div>
) : node.type === 'Heading' ? (
	node.props.level === 1 ? (
		<h1 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{node.props.text}</h1>
	) : node.props.level === 2 ? (
		<h2 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{node.props.text}</h2>
	) : node.props.level === 3 ? (
		<h3 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{node.props.text}</h3>
	) : (
		<h4 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{node.props.text}</h4>
	)
) : node.type === 'Text' ? (
	<p class:list={[baseClass, 'nvx-builder-text', `nvx-builder-text--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{node.props.text}</p>
) : node.type === 'Image' ? (
	<figure class:list={[baseClass, 'nvx-builder-image']} data-builder-id={id} style={style}>
		<div class="nvx-builder-image__frame" data-aspect={node.props.aspectRatio} data-fit={node.props.fit}>
			{node.props.src && imageAvailable ? (
				<img src={imageSource} alt={node.props.alt} loading="lazy" decoding="async" />
			) : (
				<div class="nvx-builder-image__empty" role="img" aria-label={node.props.alt || 'تصویر در دسترس نیست'}>{node.props.src ? 'فایل تصویر پیدا نشد' : 'تصویر انتخاب نشده است'}</div>
			)}
		</div>
		{node.props.caption ? <figcaption class="nvx-builder-image__caption">{node.props.caption}</figcaption> : null}
	</figure>
) : node.type === 'ProductGrid' ? (
	<ProductGrid node={node} className={baseClass} style={style} />
) : (
	<div class:list={[baseClass, 'nvx-builder-button-wrap']} data-builder-id={id} data-align={node.props.align} style={style}>
		<a class:list={['nvx-builder-button', `nvx-builder-button--${node.props.variant}`]} href={node.props.href}>{node.props.label}</a>
	</div>
)}

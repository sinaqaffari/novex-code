---
import type { BuilderNode } from '../../lib/builder/types.ts';
import { resolvePluginParts } from '../../lib/builder/plugin-components.ts';
import { controlledNodeStyle } from '../../lib/builder/render.ts';
import { resolveNodeStyles } from '../../lib/builder/responsive.ts';
import ProductGrid from './ProductGrid.astro';
import ExtendedContent from './ExtendedContent.astro';
import { sandboxedCodeDocument } from '../../lib/builder/sandboxed-code.ts';
import { globalScriptBootstrap, globalStyleRawText } from '../../lib/builder/global-code.ts';
import { isExtendedContentNode } from '../../lib/builder/extended-content.ts';
import { parseBuilderMediaReference, resolveBuilderImageSource } from '../../lib/builder/media-reference.ts';
import { assetExists } from '../../lib/cms/media.ts';
import { textRuns } from '../../lib/builder/rich-text.ts';
import RichTextRun from './RichTextRun.astro';

interface Props {
	node: BuilderNode;
}

const { node } = Astro.props;
const style = controlledNodeStyle(resolveNodeStyles(node, 'desktop'));
const id = node.id;
const baseClass = 'nvx-builder-node';
const mediaReference = node.type === 'Image' ? parseBuilderMediaReference(node.props.src) : null;
const mediaPath = mediaReference ? `${mediaReference.bucket === 'uploads' ? 'uploads/' : ''}${mediaReference.name}` : '';
const imageAvailable = node.type === 'Image' && mediaReference ? await assetExists(mediaPath) : true;
const imageSource = node.type === 'Image' ? resolveBuilderImageSource(node.props.src) : '';
---

{node.type === 'Container' ? (
	<div
		class:list={[baseClass, 'nvx-builder-container', `nvx-builder-container--${node.props.background}`]}
		data-builder-id={id}
		data-layout={node.props.layout}
		data-max-width={node.props.maxWidth}
		style={`gap:${node.props.gap}px;padding:${node.props.padding}px${style ? `;${style}` : ''}`}
	>
		{node.children.map((child) => <Astro.self node={child} />)}
	</div>
) : node.type === 'PluginBlock' ? (
	<div class:list={[baseClass, 'nvx-builder-plugin']} data-builder-id={id} style={style}>
		{resolvePluginParts(node.props).map((part) => part.type === 'heading' ? <h2 class="nvx-builder-node nvx-builder-heading nvx-builder-heading--md nvx-builder-color--ink">{part.text}</h2> : part.type === 'text' ? <p class="nvx-builder-node nvx-builder-text nvx-builder-text--md nvx-builder-color--ink">{part.text}</p> : <div class="nvx-builder-button-wrap"><a class="nvx-builder-button nvx-builder-button--outline" href={part.href}>{part.text}</a></div>)}
	</div>
) : node.type === 'Heading' ? (
	node.props.level === 1 ? (
		<h1 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{textRuns(node.props.text, node.props.marks).map((run) => <RichTextRun run={run} />)}</h1>
	) : node.props.level === 2 ? (
		<h2 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{textRuns(node.props.text, node.props.marks).map((run) => <RichTextRun run={run} />)}</h2>
	) : node.props.level === 3 ? (
		<h3 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{textRuns(node.props.text, node.props.marks).map((run) => <RichTextRun run={run} />)}</h3>
	) : (
		<h4 class:list={[baseClass, 'nvx-builder-heading', `nvx-builder-heading--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{textRuns(node.props.text, node.props.marks).map((run) => <RichTextRun run={run} />)}</h4>
	)
) : node.type === 'Text' ? (
	<p class:list={[baseClass, 'nvx-builder-text', `nvx-builder-text--${node.props.size}`, `nvx-builder-color--${node.props.color}`]} data-builder-id={id} data-align={node.props.align} style={style}>{textRuns(node.props.text, node.props.marks).map((run) => <RichTextRun run={run} />)}</p>
) : node.type === 'Image' ? (
	<figure class:list={[baseClass, 'nvx-builder-image']} data-builder-id={id} style={style}>
		<div class="nvx-builder-image__frame" data-aspect={node.props.aspectRatio} data-fit={node.props.fit}>
			{node.props.src && imageAvailable ? (
				<img src={imageSource} alt={node.props.alt} loading="lazy" decoding="async" />
			) : (
				<div class="nvx-builder-image__empty" role="img" aria-label={node.props.alt || 'تصویر در دسترس نیست'}>{node.props.src ? 'فایل تصویر پیدا نشد' : 'تصویر انتخاب نشده است'}</div>
			)}
		</div>
		{node.props.caption ? <figcaption class="nvx-builder-image__caption">{node.props.caption}</figcaption> : null}
	</figure>
) : node.type === 'Spacer' ? (
	<div class:list={[baseClass, 'nvx-builder-spacer']} data-builder-id={id} aria-hidden="true" style={`height:${node.props.size}px${style ? `;${style}` : ''}`}></div>
) : node.type === 'Divider' ? (
	<hr class:list={[baseClass, 'nvx-builder-divider', `nvx-builder-divider--${node.props.color}`]} data-builder-id={id} style={`border-top-width:${node.props.thickness}px;border-top-style:${node.props.lineStyle}${style ? `;${style}` : ''}`} />
) : isExtendedContentNode(node) ? (
	<ExtendedContent node={node} style={style} />
) : node.type === 'CodeWidget' ? (
	<div class:list={[baseClass, 'nvx-builder-code']} data-builder-id={id} style={style}><iframe title={node.props.title} srcdoc={sandboxedCodeDocument(node.props)} sandbox="allow-scripts" referrerpolicy="no-referrer" loading="lazy" style={`height:${node.props.height}px`}></iframe></div>
) : node.type === 'GlobalCode' ? (
	<Fragment>
		{node.props.css ? <style is:inline set:html={globalStyleRawText(node.props.css)} /> : null}
		{node.props.javascript ? <script is:inline set:html={globalScriptBootstrap(node.props.javascript)} /> : null}
	</Fragment>
) : node.type === 'ProductGrid' ? (
	<ProductGrid node={node} className={baseClass} style={style} />
) : node.type === 'Button' ? (
	<div class:list={[baseClass, 'nvx-builder-button-wrap']} data-builder-id={id} data-align={node.props.align} style={style}>
		<a class:list={['nvx-builder-button', `nvx-builder-button--${node.props.variant}`]} href={node.props.href}>{node.props.label}</a>
	</div>
) : (
	<div class="nvx-builder-unknown" role="status">مؤلفهٔ ناشناخته قابل نمایش نیست.</div>
)}

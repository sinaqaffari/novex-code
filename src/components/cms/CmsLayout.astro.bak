---
import '@fontsource-variable/vazirmatn';
import '../../styles/cms.css';
import Icon from './Icon.astro';
import { ADMIN_NAME } from '../../lib/cms/auth';
import { readSettings, TIMEZONES } from '../../lib/cms/settings';
import { readDatabase } from '../../lib/commerce/db';
import { listPluginPages } from '../../lib/plugins/registry';

export interface Crumb {
	label: string;
	href?: string;
}

type IconName =
	| 'dashboard'
	| 'posts'
	| 'media'
	| 'settings'
	| 'language'
	| 'box'
	| 'receipt'
	| 'users'
	| 'ticket'
	| 'layers'
	| 'chart';

interface NavItem {
	href: string;
	label: string;
	icon: IconName;
	match: RegExp;
	badge?: number;
}

interface Props {
	title: string;
	subtitle?: string;
	variant?: 'panel' | 'auth';
	breadcrumbs?: Crumb[];
	/** صفحه‌های تمام‌عرض (مثل ویرایشگر) نیازی به حداکثر عرض ندارند. */
	wide?: boolean;
}

const { title, subtitle, variant = 'panel', breadcrumbs = [], wide = false } = Astro.props;

const settings = await readSettings();
const pathname = Astro.url.pathname;
const pluginPages = listPluginPages();
const commerceReady = settings.commerceEnabled;

const pendingOrders = commerceReady
	? (await readDatabase()).orders.filter((order) => order.status === 'pending').length
	: 0;

const flashMap: Record<string, { tone: 'success' | 'error' | 'info'; text: string }> = {
	created: { tone: 'success', text: 'با موفقیت ساخته شد.' },
	saved: { tone: 'success', text: 'تغییرات ذخیره شد.' },
	deleted: { tone: 'success', text: 'با موفقیت حذف شد.' },
	duplicated: { tone: 'success', text: 'یک رونوشت پیش‌نویس ساخته شد.' },
	uploaded: { tone: 'success', text: 'تصویر با موفقیت بارگذاری شد.' },
	'media-deleted': { tone: 'success', text: 'فایل از کتابخانه حذف شد.' },
	'settings-saved': { tone: 'success', text: 'تنظیمات سایت به‌روزرسانی شد.' },
	'shipped': { tone: 'success', text: 'وضعیت سفارش به‌روزرسانی شد.' },
	'status-updated': { tone: 'success', text: 'وضعیت با موفقیت تغییر کرد.' },
	'plugin-activated': { tone: 'success', text: 'افزونه فعال شد و قلاب‌هایش ثبت شدند.' },
	'plugin-deactivated': { tone: 'success', text: 'افزونه غیرفعال شد و قلاب‌هایش برداشته شدند.' },
	'plugin-options-saved': { tone: 'success', text: 'تنظیمات افزونه ذخیره شد.' },
	'plugin-uninstalled': { tone: 'success', text: 'داده‌های افزونه پاک شد.' },
};

const flashKey = Astro.url.searchParams.get('flash') ?? '';
const flash = flashMap[flashKey];
const errorMessage = Astro.url.searchParams.get('error') ?? '';

const navGroups: Array<{ label: string; items: NavItem[] }> = [
	{
		label: 'میزکار',
		items: [
			{ href: '/cms', label: 'داشبورد', icon: 'dashboard' as const, match: /^\/cms\/?$/ },
		],
	},
	{
		label: 'محتوا',
		items: [
			{
				href: '/cms/posts',
				label: 'نوشته‌ها',
				icon: 'posts' as const,
				match: /^\/cms\/posts(\/|$)/,
			},
			{
				href: '/cms/media',
				label: 'کتابخانهٔ رسانه',
				icon: 'media' as const,
				match: /^\/cms\/media/,
			},
		],
	},
	...(commerceReady
		? [
			{
				label: 'فروشگاه',
				items: [
					{
						href: '/cms/products',
						label: 'محصولات',
						icon: 'box' as const,
						match: /^\/cms\/products(\/|$)/,
					},
					{
						href: '/cms/orders',
						label: 'سفارش‌ها',
						icon: 'receipt' as const,
						match: /^\/cms\/orders(\/|$)/,
						badge: pendingOrders,
					},
					{
						href: '/cms/customers',
						label: 'مشتریان',
						icon: 'users' as const,
						match: /^\/cms\/customers/,
					},
					{
						href: '/cms/discounts',
						label: 'کدهای تخفیف',
						icon: 'ticket' as const,
						match: /^\/cms\/discounts/,
					},
					{
						href: '/cms/reports/revenue',
						label: 'گزارش درآمد',
						icon: 'chart' as const,
						match: /^\/cms\/reports/,
					},
				],
			},
		]
		: []),
	{
		label: 'سیستم',
		items: [
			{
				href: '/cms/settings',
				label: 'تنظیمات سایت',
				icon: 'settings' as const,
				match: /^\/cms\/settings/,
			},
			{
				href: '/cms/plugins',
				label: 'افزونه‌ها',
				icon: 'layers' as const,
				match: /^\/cms\/plugins\/?$/,
			},
			{
				href: '/cms/language',
				label: 'زبان و نمایش',
				icon: 'language' as const,
				match: /^\/cms\/language/,
			},
		],
	},
	...(pluginPages.length
		? [
			{
				label: 'صفحه‌های افزونه',
				items: pluginPages.map(({ pluginId, page }) => {
					const base = `/cms/plugins/${pluginId}/${page.path}`;
					return {
						href: base,
						label: page.title,
						icon: 'layers' as const,
						match: new RegExp(`^${base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(/|$)`),
					};
				}),
			},
		]
		: []),
];

const isActive = (pattern: RegExp) => pattern.test(pathname);
const timezoneLabel =
	TIMEZONES.find((zone) => zone.value === settings.timezone)?.label ?? settings.timezone;
const authorInitial = (settings.authorName || ADMIN_NAME || 'ن').trim().charAt(0);
const searchQuery = Astro.url.pathname === '/cms/search' ? (Astro.url.searchParams.get('q') ?? '') : '';
---

<!doctype html>
<html lang="fa" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#1b1f24" />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} | پنل مدیریت {settings.siteTitle}</title>
		<meta name="description" content="پنل مدیریت محتوای فارسی نووکس‌کد — راست‌به‌چپ." />
	</head>
	<body class:list={['cms', `cms--${variant}`]}>
		<a class="skip-link" href="#cms-main">پرش به محتوای اصلی</a>

		{
			variant === 'auth' ? (
				<main id="cms-main" class="auth">
					<slot />
				</main>
			) : (
				<div class="shell">
					<aside class="sidebar" id="cms-sidebar" aria-label="ناوبری پنل مدیریت">
						<a class="brand" href="/cms">
							<span class="brand__mark" aria-hidden="true">ن</span>
							<span class="brand__text">
								<span class="brand__title">{settings.siteTitle}</span>
								<span class="brand__subtitle">پنل مدیریت محتوا</span>
							</span>
						</a>

						<nav class="nav">
							{navGroups.map((group) => (
								<div class="nav-group">
									<span class="nav-group__label">{group.label}</span>
									{group.items.map((item) => (
										<a
											class="nav-link"
											href={item.href}
											aria-current={isActive(item.match) ? 'page' : undefined}
										>
											<Icon name={item.icon} size={17} />
											<span>{item.label}</span>
											{item.badge ? (
												<span class="nav-link__badge num">{item.badge.toLocaleString('fa-IR')}</span>
											) : null}
										</a>
									))}
								</div>
							))}
						</nav>

						<div class="sidebar__footer">
							{commerceReady && (
								<a class="sidebar__store" href="/shop" target="_blank" rel="noreferrer">
									<Icon name="store" size={16} />
									<span>مشاهدهٔ فروشگاه</span>
									<Icon name="external" size={13} />
								</a>
							)}
							<div class="user-card">
								<span class="avatar" aria-hidden="true">{authorInitial}</span>
								<span class="grow">
									<span class="user-card__name">{settings.authorName || 'مدیر سایت'}</span>
									<br />
									<span class="user-card__role">مدیر ارشد محتوا</span>
								</span>
							</div>
							<form class="logout-form" method="post" action="/cms/api/logout">
								<button class="logout-button" type="submit">
									<Icon name="logout" size={15} />
									<span>خروج از حساب</span>
								</button>
							</form>
						</div>
					</aside>

					<div class="sidebar-scrim" data-sidebar-close hidden />

					<div class="main">
						<header class="topbar">
							<div class="topbar__heading grow">
								<div class="row" style="gap:.5rem">
									<button
										class="btn btn--outline btn--icon sidebar-toggle"
										type="button"
										data-sidebar-toggle
										aria-controls="cms-sidebar"
										aria-expanded="false"
										aria-label="نمایش منو"
									>
										<Icon name="menu" size={18} />
									</button>
									{breadcrumbs.length > 0 && (
										<nav class="breadcrumbs" aria-label="مسیر صفحه">
											<a href="/cms">پنل</a>
											{breadcrumbs.map((crumb) => (
												<>
													<Icon name="arrow" size={12} />
													{crumb.href ? (
														<a href={crumb.href}>{crumb.label}</a>
													) : (
														<span aria-current="page">{crumb.label}</span>
													)}
												</>
											))}
										</nav>
									)}
								</div>
								<h1 class="topbar__title">{title}</h1>
								{subtitle && <p class="topbar__subtitle">{subtitle}</p>}
							</div>
							<div class="topbar__actions">
								<form class="topbar-search" method="get" action="/cms/search" role="search">
									<Icon name="search" size={15} />
									<input
										type="search"
										name="q"
										value={searchQuery}
										placeholder="جست‌وجو در پنل…"
										aria-label="جست‌وجو در پنل"
									/>
									<kbd>⌘K</kbd>
								</form>
								<slot name="actions" />
								<a class="btn btn--ghost btn--sm" href="/" target="_blank" rel="noreferrer">
									<Icon name="external" size={15} />
									<span>سایت</span>
								</a>
							</div>
						</header>

						<main id="cms-main" class:list={['content', wide && 'content--wide']}>
							{flash && (
								<div
									class={`alert alert--${flash.tone}`}
									role="status"
									style="margin-block-end: 1.1rem"
								>
									<Icon name={flash.tone === 'success' ? 'check' : 'info'} size={17} />
									<span>{flash.text}</span>
								</div>
							)}
							{errorMessage && (
								<div class="alert alert--error" role="alert" style="margin-block-end: 1.1rem">
									<Icon name="alert" size={17} />
									<span>{errorMessage}</span>
								</div>
							)}
							<div class="stack">
								<slot />
							</div>
						</main>

						<footer class="panel-footer">
							<span>پنل مدیریت {settings.siteTitle}</span>
							<span>گزارش‌ها به وقت {timezoneLabel}</span>
						</footer>
					</div>
				</div>
			)
		}

		<script>
			const sidebar = document.getElementById('cms-sidebar');
			const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
			const scrim = document.querySelector<HTMLElement>('.sidebar-scrim');

			const setSidebar = (open: boolean) => {
				if (!sidebar) return;
				sidebar.classList.toggle('is-open', open);
				scrim?.classList.toggle('is-visible', open);
				if (scrim) scrim.hidden = !open;
				toggle?.setAttribute('aria-expanded', String(open));
			};

			toggle?.addEventListener('click', () => {
				setSidebar(!sidebar?.classList.contains('is-open'));
			});
			scrim?.addEventListener('click', () => setSidebar(false));
			document.querySelectorAll('.nav-link').forEach((link) => {
				link.addEventListener('click', () => setSidebar(false));
			});
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') setSidebar(false);
				// ⌘K / Ctrl+K focuses the global search from anywhere in the panel.
				if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
					const search = document.querySelector<HTMLInputElement>('.topbar-search input');
					if (search) {
						event.preventDefault();
						search.focus();
						search.select();
					}
				}
			});

			document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
				form.addEventListener('submit', (event) => {
					const message = form.dataset.confirm ?? 'آیا مطمئن هستید؟';
					if (!window.confirm(message)) event.preventDefault();
				});
			});

			window.addEventListener('cms:error', (event) => {
				const detail = (event as CustomEvent<{ message?: string }>).detail;
				if (!detail?.message) return;
				const box = document.createElement('div');
				box.className = 'alert alert--error';
				box.setAttribute('role', 'alert');
				box.style.marginBlockEnd = '1.1rem';
				box.textContent = detail.message;
				const content = document.querySelector('.content .stack');
				content?.prepend(box);
				box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
				setTimeout(() => box.remove(), 8000);
			});
		</script>
	</body>
</html>

---
import { readSettings } from '../../lib/cms/settings';
const settings = await readSettings();
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__grid">
			<div class="footer__col">
				<a class="footer__brand" href="/">
					<span class="footer__mark" aria-hidden="true">
						<svg viewBox="0 0 36 36" fill="none"><path d="M8 28V8h5l10 13V8h5v20h-5L13 15v13H8Z" fill="currentColor"/><path d="M6 32h24" stroke="currentColor" stroke-width="2"/></svg>
					</span>
					<span class="footer__name">{settings.siteTitle}</span>
				</a>
				<p class="footer__desc">{settings.siteDescription}</p>
				{settings.social.github && (
					<div class="footer__social">
						<a href={settings.social.github} target="_blank" rel="noreferrer" class="footer__social-link" aria-label="گیت‌هاب نووکس‌کد">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path d="M9 19c-4.5 1.4-4.5-2.5-6.5-3m13 6v-3.6c0-1-.4-1.8-1-2.4 3.2-.4 6.5-1.5 6.5-6.8a5.3 5.3 0 0 0-1.4-3.7 4.9 4.9 0 0 0-.1-3.7s-1.2-.4-3.8 1.4a13.2 13.2 0 0 0-7 0C4.9 1.4 3.7 1.8 3.7 1.8a4.9 4.9 0 0 0-.1 3.7 5.3 5.3 0 0 0-1.4 3.7c0 5.3 3.3 6.4 6.5 6.8-.6.5-.9 1.2-1 2.1V22" />
							</svg>
						</a>
					</div>
				)}
			</div>

			<div class="footer__col">
				<h2 class="footer__heading">کاوش</h2>
				<ul class="footer__list">
					{settings.commerceEnabled && <li><a href="/shop">محصولات</a></li>}
					<li><a href="/blog">مجلهٔ توسعه‌دهندگان</a></li>
					<li><a href="/about">دربارهٔ نووکس‌کد</a></li>
				</ul>
			</div>

			<div class="footer__col">
				<h2 class="footer__heading">راهنما و سفارش</h2>
				<ul class="footer__list">
					<li><a href="/blog/docker">اجرای پروژه با Docker</a></li>
					<li><a href="/blog/rahnamaye-kharid">راهنمای خرید</a></li>
					{settings.commerceEnabled && <li><a href="/shop/track">پیگیری سفارش</a></li>}
					{settings.enableRss && <li><a href="/rss.xml">خوراک RSS</a></li>}
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<span class="footer__copyright">© {new Date().getFullYear()} {settings.siteTitle} — تمام حقوق محفوظ است.</span>
			<span>{settings.footerNote}</span>
		</div>
	</div>
</footer>

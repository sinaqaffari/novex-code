---
import '../../styles/design.css';
import type { SiteSettings } from '../../lib/cms/settings';
import { safeExternalUrl } from '../../lib/urls';

interface Props {
	settings: SiteSettings;
}

const { settings } = Astro.props;
const socialLinks = {
	github: safeExternalUrl(settings.social.github),
	telegram: safeExternalUrl(settings.social.telegram),
	instagram: safeExternalUrl(settings.social.instagram),
	linkedin: safeExternalUrl(settings.social.linkedin),
};
---

<footer class="footer">
	<div class="container footer__inner">
		<div class="footer__grid">
			<div class="footer__col">
				<div class="footer__brand">
					<span class="footer__mark" aria-hidden="true">ن</span>
					<span class="footer__name">{settings.siteTitle}</span>
				</div>
				<p class="footer__desc">{settings.siteDescription}</p>
				{(socialLinks.github || socialLinks.telegram || socialLinks.instagram || socialLinks.linkedin) && (
					<nav class="footer__social" aria-label="شبکه‌های اجتماعی" style="display:flex;gap:var(--space-3);margin-block-start:var(--space-4)">
						{socialLinks.github && (
							<a href={socialLinks.github} target="_blank" rel="noreferrer" class="footer__social-link" aria-label="گیت‌هاب">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-4.77 0 0-.84-.42-1.7-.72-1.82-.49-2.36-.6-3.74-.65-.39-.04-.78-.02-1.17.04-.84.14-1.67.37-2.08.73-1.68-1.86-4.58-2.2-4.58-4.63 0 0-1.12-1.45-2.77-2.12-.88-1.02-1.42-1.49-1.42-1.49-.2-.12-.48-.24-.78-.45-.47-.02-.68-.08-.68-.08-.99-.22-.52-.58-.07-.58-.58 0 0 1.24.08 1.95 1.29.76-.22 1.6-.34 2.44-.34.41 0 .81.01 1.19.1.72-.11 1.47-.22 2.25-.28.47-.06.57-.06 1 .06 1.05.32 1.97.84 2.25 1.78 1.24-1.75 2.23-3.11 2.23-4.51 0-2.18-1.11-3.92-2.9-4.67-.39-.18-.79-.35-1.2-.53-.12-.29-.27-.56-.37-.86-.1-.57-.03-1.14.22-1.57.05-.09.09-.17.13-.26.13-.31.27-.61.36-.89-.13-.2-.29-.39-.46-.58-.1-.12-.22-.18-.35-.24-.13-.06-.26-.07-.39-.07-.37 0-.73.05-1.08.15-.63.18-1.19.52-1.66.99-.46.46-.74 1.05-.74 1.73 0 .43.12.82.29 1.17.29.61.74 1.11 1.37 1.41.02.01.03.02.05.03.41.21.77.48 1.03.82.65.84.97 1.88.97 3.05 0 1.62-.71 3.21-1.91 4.31.15.2.31.41.49.61.29.31.61.58.95.81.17.11.35.2.53.28.15.07.31.1.47.11.17.02.35.03.52.03.31 0 .61-.03.92-.09.24-.04.47-.07.7-.09.18-.02.36-.02.54-.02.31 0 .62-.01.93-.03.2-.01.39-.03.58-.05.16-.01.33-.02.49-.03.12 0 .24-.01.36-.02.1-.01.19-.01.29-.02.06 0 .13-.01.19-.01.14 0 .28-.01.42-.02.09 0 .18-.01.27-.02.06 0 .13-.01.19-.02.07 0 .14-.01.21-.02.05 0 .1-.01.15-.02.04 0 .08-.01.12-.02.03 0 .06-.01.09-.02.03 0 .05-.01.08-.02.02 0 .05-.01.07-.02.02 0 .03-.01.05-.02.01 0 .02-.01.03-.02 0 0 .01-.01.01-.01L22 3.92c-.01-.01-.01-.02-.02-.03-.01-.01-.01-.02-.02-.04-.01-.01-.01-.02-.02-.03-.01-.01-.01-.02-.02-.04-.01-.01-.01-.02-.02-.03-.01-.01-.01-.02-.02-.04z" />
								</svg>
							</a>
						)}
						{socialLinks.linkedin && (
							<a href={socialLinks.linkedin} target="_blank" rel="noreferrer" class="footer__social-link" aria-label="لینکدین">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" />
								</svg>
							</a>
						)}
						{socialLinks.telegram && (
							<a href={socialLinks.telegram} target="_blank" rel="noreferrer" class="footer__social-link footer__social-link--text">تلگرام</a>
						)}
						{socialLinks.instagram && (
							<a href={socialLinks.instagram} target="_blank" rel="noreferrer" class="footer__social-link footer__social-link--text">اینستاگرام</a>
						)}
					</nav>
				)}
			</div>

			<div class="footer__col">
				<h2 class="footer__heading">صفحه‌ها</h2>
				<ul class="footer__list">
					<li><a href="/">خانه</a></li>
					<li><a href="/blog">مجله</a></li>
					<li><a href="/about">درباره</a></li>
					{settings.enableRss && <li><a href="/rss.xml">خوراک RSS</a></li>}
				</ul>
			</div>

			{settings.commerceEnabled && (
				<div class="footer__col">
					<h2 class="footer__heading">سفارش‌ها</h2>
					<ul class="footer__list">
						<li><a href="/shop">فهرست محصولات</a></li>
						<li><a href="/shop/cart">سبد خرید</a></li>
						<li><a href="/shop/track">پیگیری سفارش</a></li>
					</ul>
				</div>
			)}

			{settings.authorEmail && (
				<div class="footer__col">
					<h2 class="footer__heading">ارتباط</h2>
					<ul class="footer__list">
						<li><a href={`mailto:${settings.authorEmail}`}>{settings.authorEmail}</a></li>
					</ul>
				</div>
			)}
		</div>

		<div class="footer__bottom">
			<span class="footer__copyright">
				© {new Date().getFullYear()} {settings.siteTitle} — تمام حقوق محفوظ است.
			</span>
			<span class="footer__note">{settings.footerNote}</span>
		</div>
	</div>
</footer>

<style>
	.footer__social-link--text {
		width: auto;
		min-width: 2rem;
		padding-inline: 0.45rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		font-size: var(--text-xs);
	}

	.footer__bottom {
		margin-block-start: var(--space-6);
		padding-block-start: var(--space-4);
		border-block-start: 1px solid var(--line);
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
</style>

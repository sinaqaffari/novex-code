---
/* ==========================================================================
   نووکس‌کد — پیش‌نمایش مقالات مجله (بخش reused شده)
   پیش‌نمایش کد‌محور برای نوشته‌های بدون تصویر، نه حروف تصادفی.
   ========================================================================== */

import { faReadingTime } from '../../lib/cms/fa';

interface Props {
	post: {
		title: string;
		description: string;
		pubDate: string;
		words: number;
		tags: string[];
		slug: string;
	};
	featured?: boolean;
}

const { post, featured = false } = Astro.props;

const topicIcons: Record<string, string> = {
	زیرساخت: 'terminal',
	داکر: 'container',
	فروشگاه: 'cart',
	راهنما: 'book',
	طراحی: 'pencil',
	رASTbyCHP: 'rtl',
};

const getTopicIcon = (tags: string[]): string => {
	for (const tag of tags) {
		if (topicIcons[tag]) return topicIcons[tag];
	}
	return 'code';
};

const icon = getTopicIcon(post.tags);
const cardClass = featured ? 'blog-card blog-card--featured' : 'blog-card';
---

<article class={cardClass}>
	<div class="blog-card__media" aria-hidden="true">
		<div class="blog-code-preview">
			<div class="blog-code-preview__bar">
				<div class="blog-code-preview__dot blog-code-preview__dot--red"></div>
				<div class="blog-code-preview__dot blog-code-preview__dot--yellow"></div>
				<div class="blog-code-preview__dot blog-code-preview__dot--green"></div>
				<span class="blog-code-preview__lang">{icon}</span>
			</div>
			<div class="blog-code-preview__lines">
				<div class="blog-code-preview__line">
					<span class="blog-code-preview__token blog-code-preview__token--keyword">const</span>
					<span class="blog-code-preview__token blog-code-preview__token--space"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--name">config</span>
					<span class="blog-code-preview__token blog-code-preview__token--space"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--operator">=</span>
					<span class="blog-code-preview__token blog-code-preview__token--space"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--operator">&#123;</span>
				</div>
				<div class="blog-code-preview__line">
					<span class="blog-code-preview__token blog-code-preview__token--indent"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--name">rtl</span>
					<span class="blog-code-preview__token blog-code-preview__token--punctuation">:</span>
					<span class="blog-code-preview__token blog-code-preview__token--space"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--boolean">true</span>
					<span class="blog-code-preview__token blog-code-preview__token--punctuation">,</span>
				</div>
				<div class="blog-code-preview__line">
					<span class="blog-code-preview__token blog-code-preview__token--indent"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--name">dir</span>
					<span class="blog-code-preview__token blog-code-preview__token--punctuation">:</span>
					<span class="blog-code-preview__token blog-code-preview__token--space"> </span>
					<span class="blog-code-preview__token blog-code-preview__token--string">'fa-IR'</span>
					<span class="blog-code-preview__token blog-code-preview__token--punctuation">,</span>
				</div>
				<div class="blog-code-preview__line">
					<span class="blog-code-preview__token blog-code-preview__token--operator">&#125;</span>
				</div>
			</div>
		</div>
	</div>

	<div class="blog-card__body">
		<div class="blog-card__tags">
			{post.tags.map((tag) => (
				<a href={`/blog?tag=${encodeURIComponent(tag)}`} class="blog-card__tag">
					{tag}
				</a>
			))}
		</div>
		<span class="blog-card__meta num">
			{post.pubDate} — {faReadingTime(post.words)}
		</span>
		<h2 class="blog-card__title">{post.title}</h2>
		<p class="blog-card__desc">{post.description}</p>
		<a href={`/blog/${post.slug}`} class="blog-card__link">
			ادامهٔ مطلب
			<span aria-hidden="true"> →</span>
		</a>
	</div>
</article>

<style>
	.blog-card {
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
		transition: border-color 0.15s, box-shadow 0.15s;
	}

	.blog-card:hover {
		border-color: var(--line-strong);
		box-shadow: var(--shadow-sm);
		color: var(--ink);
	}

	.blog-card--featured {
		grid-column: span 2;
	}

	.blog-card__media {
		aspect-ratio: 16 / 9;
		border-block-end: 1px solid var(--line);
		background: var(--surface-2);
		display: grid;
		place-items: center;
		position: relative;
		overflow: hidden;
	}

	.blog-code-preview {
		width: 100%;
		height: 100%;
		background: #0f172a;
		display: flex;
		flex-direction: column;
	}

	.blog-code-preview__bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: #1e293b;
		border-block-end: 1px solid #334155;
	}

	.blog-code-preview__dot {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
	}

	.blog-code-preview__dot--red {
		background: #ef4444;
	}

	.blog-code-preview__dot--yellow {
		background: #eab308;
	}

	.blog-code-preview__dot--green {
		background: #22c55e;
	}

	.blog-code-preview__lang {
		margin-inline-start: auto;
		color: #94a3b8;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.blog-code-preview__lines {
		flex: 1;
		padding: 1rem;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		line-height: 1.6;
		color: #cbd5e1;
	}

	.blog-code-preview__line {
		margin: 0;
	}

	.blog-code-preview__token--keyword {
		color: #c678dd;
	}

	.blog-code-preview__token--name {
		color: #61afef;
	}

	.blog-code-preview__token--operator {
		color: #56b6c2;
	}

	.blog-code-preview__token--boolean {
		color: #d19a66;
	}

	.blog-code-preview__token--string {
		color: #98c379;
	}

	.blog-code-preview__token--punctuation {
		color: #abb2bf;
	}

	.blog-code-preview__token--indent {
		color: #5c6370;
		padding-inline-start: 1rem;
	}

	.blog-code-preview__token--space {
		color: #cbd5e1;
	}

	.blog-card__body {
		padding: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		flex: 1;
	}

	.blog-card__tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.blog-card__tag {
		font-size: var(--text-xs);
		font-weight: var(--font-weight-medium);
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--line);
		background: var(--surface-2);
		color: var(--ink-soft);
	}

	.blog-card__tag:hover {
		border-color: var(--brand);
		color: var(--brand);
		background: var(--brand-soft);
	}

	.blog-card__meta {
		font-size: var(--text-xs);
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.blog-card__title {
		margin: 0;
		font-size: var(--text-lg);
		font-weight: var(--font-weight-bold);
		color: var(--ink);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.blog-card__desc {
		font-size: var(--text-sm);
		color: var(--ink-soft);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
		margin: 0;
	}

	.blog-card__link {
		margin-block-start: auto;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-sm);
		font-weight: var(--font-weight-semibold);
		color: var(--brand);
		text-decoration: none;
	}

	.blog-card__link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.blog-card--featured h2 {
		font-size: var(--text-xl);
	}

	.blog-card--featured .blog-card__desc {
		-webkit-line-clamp: 3;
		font-size: var(--text-base);
	}

	.blog-card--featured .blog-code-preview__lines {
		font-size: 0.85rem;
	}

	@media (max-width: 640px) {
		.blog-card--featured {
			grid-column: span 1;
		}
	}
</style>

---
import ShopLayout from '../layouts/ShopLayout.astro';
import { defaultSettings, readSettings } from '../lib/cms/settings';
import { hydrateCart, readCart } from '../lib/commerce/cart';

export const prerender = false;

const [settings, cart] = await Promise.all([
	readSettings(),
	hydrateCart(readCart(Astro.cookies)),
]);
---

<ShopLayout title="دربارهٔ نووکس‌کد" description={settings.siteDescription} cartCount={cart.count}>
	<nav class="breadcrumbs" aria-label="مسیر"><a href="/">خانه</a><span aria-hidden="true">/</span><span aria-current="page">درباره</span></nav>

	<header class="about-intro">
		<span class="about-intro__eyebrow">دربارهٔ پروژه</span>
		<h1>{settings.siteTitle}</h1>
		<p>{settings.siteDescription}</p>
	</header>

	<div class="prose about-content">
		<p>نووکس‌کد یک وب‌سایت Astro با رابط فارسی و راست‌به‌چپ است. مجله از فایل‌های Markdown خوانده می‌شود و داده‌های فروشگاه و تنظیمات در فایل‌های محلی پروژه نگهداری می‌شوند.</p>

		<h2>امکانات موجود</h2>
		<ul>
			<li>مجلهٔ عمومی با نوشته‌های منتشرشده و خوراک RSS در صورت فعال‌بودن آن.</li>
			<li>فهرست محصولات فعال، سبد خرید، محاسبهٔ سفارش و مسیر پرداخت فروشگاه.</li>
			<li>پیگیری سفارش با شمارهٔ سفارش و شمارهٔ تماس ثبت‌شده.</li>
			<li>پنل مدیریت محتوا و فروشگاه، با دسترسی مبتنی بر نقش و مجوز.</li>
			<li>فایل‌های Docker و Compose برای اجرای پروژه در محیط کانتینری.</li>
		</ul>

		<h2>دربارهٔ محصولات</h2>
		<p>صفحهٔ محصول اطلاعات ثبت‌شده در فروشگاه را نمایش می‌دهد. نسخه، مجوز، مستندات، سازگاری و فهرست فایل‌ها برای محصولات فعلی ثبت نشده‌اند؛ بنابراین در صفحهٔ محصول نیز این جزئیات ادعا نمی‌شوند.</p>

		<h2>حساب کاربری و دانلود</h2>
		<p>در حال حاضر حساب مشتری، سابقهٔ خرید و دانلود محافظت‌شده در وب‌سایت پیاده‌سازی نشده‌اند. پیگیری سفارش، تنها اطلاعات ثبت‌شدهٔ همان سفارش را نشان می‌دهد.</p>

		<h2>پرداخت</h2>
		<p>شروع و تأیید پرداخت به افزونه و تنظیمات درگاه وابسته است. پیش از استفادهٔ واقعی، وضعیت افزونه و تنظیمات محیط اجرا را بررسی کنید.</p>

		{settings.authorEmail && settings.authorEmail !== defaultSettings.authorEmail ? <p>تماس: <a class="ltr" href={`mailto:${settings.authorEmail}`}>{settings.authorEmail}</a></p> : null}
	</div>
</ShopLayout>

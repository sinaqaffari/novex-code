---
import ShopLayout from '../layouts/ShopLayout.astro';
import '../styles/policies.css';
import { readSettings } from '../lib/cms/settings';
import { hydrateCart, readCart } from '../lib/commerce/cart';

export const prerender = false;

const [settings, cart] = await Promise.all([readSettings(), hydrateCart(readCart(Astro.cookies))]);
---

<ShopLayout title="شرایط فروش" description={`راهنمای ثبت سفارش در ${settings.siteTitle}.`} cartCount={cart.count} settings={settings}>
	<div class="policy-page">
		<nav class="breadcrumbs" aria-label="مسیر"><a href="/">خانه</a><span aria-hidden="true">/</span><a href="/policies">سیاست‌ها</a><span aria-hidden="true">/</span><span aria-current="page">شرایط فروش</span></nav>
		<header class="policy-page__intro"><span class="policy-page__eyebrow">راهنمای خرید</span><h1>شرایط فروش</h1><p>این صفحه توضیح می‌دهد چه چیزی را خود سامانه در زمان ثبت سفارش انجام می‌دهد؛ جزئیات قراردادی یا تجاریِ تعیین‌نشده به‌عنوان واقعیت اعلام نمی‌شوند.</p></header>

		<section class="policy-page__section">
			<h2>محصول، قیمت و موجودی</h2>
			<p>فقط محصولاتی که در فروشگاه فعال هستند در فهرست عمومی نمایش داده می‌شوند. مبلغ، موجودی و جمع سفارش هنگام ثبت، دوباره در سرور بررسی می‌شود؛ اگر موجودی کافی نباشد سفارش ثبت نمی‌شود.</p>
			<p>هزینهٔ ارسال و تخفیفِ قابل اعمال در خلاصهٔ سفارش پیش از ثبت نشان داده می‌شود. قیمت نهایی همان مبلغی است که سرور هنگام ایجاد سفارش محاسبه و در صفحهٔ سفارش ثبت می‌کند.</p>
		</section>

		<section class="policy-page__section">
			<h2>ثبت سفارش و پرداخت</h2>
			<p>ثبت سفارش به‌تنهایی به معنی پرداخت موفق نیست. وضعیت سفارش پس از ثبت نمایش داده می‌شود و فقط تأیید سمت سرور از درگاهِ پیکربندی‌شده می‌تواند وضعیت پرداخت را تأیید کند.</p>
			<p>اگر برای فروشگاه افزونهٔ درگاه و نشانی عمومی امن تنظیم نشده باشد، سفارش ممکن است بدون پرداخت آنلاین در وضعیت انتظار ثبت شود؛ در این نسخه نباید پرداختی را موفق فرض کرد. اگر نتیجهٔ پرداخت نامشخص است، برای جلوگیری از پرداخت تکراری، وضعیت سفارش را بررسی کنید.</p>
			<p>ثبت سفارش با کلید یکتای درخواست در برابر ارسال دوبارهٔ همان فرم محافظت می‌شود؛ برای بازفرست سفارش از همان فرم استفاده کنید و کلیدهای آن را تغییر ندهید.</p>
		</section>

		<section class="policy-page__section">
			<h2>مواردی که باید توسط فروشگاه تکمیل شوند</h2>
			<ul>
				<li>مالیات، هزینه‌های احتمالی دیگر و روش صدور فاکتور؛</li>
				<li>زمان و محدودهٔ تحویل، شرکت حمل‌ونقل و روش رسیدگی به آسیب یا تأخیر؛</li>
				<li>شرایط لغو سفارش، مرجوعی، ضمانت و بازپرداخت.</li>
			</ul>
			<p>تا وقتی این موارد در سایت یا اطلاعات سفارش به‌روشنی اعلام نشده‌اند، این صفحه برای آن‌ها مهلت یا تضمین تازه‌ای تعیین نمی‌کند.</p>
			<p class="policy-page__notice">این متن نمونهٔ توضیحی است و جایگزین شرایط فروش بررسی‌شده برای کسب‌وکار شما نیست.</p>
		</section>
	</div>
</ShopLayout>

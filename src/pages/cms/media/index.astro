---
import CmsLayout from '../../../components/cms/CmsLayout.astro';
import Icon from '../../../components/cms/Icon.astro';
import Pagination from '../../../components/cms/Pagination.astro';
import { faDate, faFileSize, faNumber } from '../../../lib/cms/fa';
import { ALLOWED_UPLOAD_EXTENSIONS, listMedia } from '../../../lib/cms/media';
import { can } from '../../../lib/cms/rbac';
import { paginate } from '../../../lib/cms/listing';

export const prerender = false;

const canDeleteMedia = can(Astro.locals.cmsUser?.role ?? 'subscriber', 'cms.media:delete');
const media = await listMedia({ dimensions: false });
const uploads = media.filter((item) => !item.builtin);
const builtin = media.filter((item) => item.builtin);
const totalBytes = media.reduce((sum, item) => sum + item.bytes, 0);
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = query.toLowerCase();
const uploadPage = paginate(uploads.filter((item) => !needle || item.name.toLowerCase().includes(needle)), Number(Astro.url.searchParams.get('page') ?? 1), 24);
const builtinPage = paginate(builtin, Number(Astro.url.searchParams.get('builtinPage') ?? 1), 12);
---

<CmsLayout
	title="کتابخانهٔ رسانه"
	subtitle={`${faNumber(media.length)} فایل — مجموع ${faFileSize(totalBytes)} — تصاویر در مسیر src/assets ذخیره می‌شوند.`}
>
	<Fragment slot="actions">
		<label class="btn btn--primary btn--sm" for="media-input">
			<Icon name="upload" size={15} />
			<span>بارگذاری تصویر</span>
		</label>
	</Fragment>

	<section class="stack">
		<form
			class="dropzone"
			method="post"
			action="/cms/api/media/upload"
			enctype="multipart/form-data"
			data-upload-form
		>
			<input
				class="sr-only"
				id="media-input"
				type="file"
				name="files"
				accept={ALLOWED_UPLOAD_EXTENSIONS.map((extension) => `.${extension}`).join(',')}
				multiple
				data-file-input
			/>
			<Icon name="image" size={20} />
			<span data-dropzone-label role="status" aria-live="polite">
				تصاویر را اینجا رها کنید یا انتخاب کنید — JPG، PNG، WebP، AVIF و GIF؛ هر فایل تا ۸ مگابایت، حداکثر ۵ فایل و مجموع ۱۶ مگابایت
			</span>
			<label data-deduplicate-option><input type="checkbox" name="deduplicate" value="1" /> استفاده از فایل یکسان موجود به‌جای ساخت رونوشت</label>
			<label class="btn btn--outline btn--sm" for="media-input">انتخاب تصویر</label>
			<button class="btn btn--primary btn--sm" type="submit" data-upload-submit hidden>
				<span>شروع بارگذاری</span>
			</button>
			<noscript><button class="btn btn--primary btn--sm" type="submit">شروع بارگذاری</button></noscript>
		</form>

		<div class="card">
			<div class="card__head">
				<div>
					<h2 class="card__title">بارگذاری‌های شما</h2>
					<p class="card__hint">فایل‌های تازه در مسیر src/assets/uploads ذخیره می‌شوند.</p>
				</div>
				<form class="toolbar" method="get" action="/cms/media" role="search">
					<label class="search">
						<span class="sr-only">جست‌وجوی نام فایل</span>
						<Icon name="search" size={16} />
						<input class="input" type="search" name="q" value={query} placeholder="جست‌وجوی نام فایل…" />
					</label>
					<button class="btn btn--outline btn--sm" type="submit">جست‌وجو</button>
				</form>
			</div>

			{uploadPage.total ? (
				<div class="card__body">
					<div class="media-grid" data-media-grid>
						{uploadPage.items.map((item) => (
							<figure class="media-tile" data-media-item data-name={item.name.toLowerCase()}>
								<img
									class="media-tile__thumb"
									src={item.previewUrl}
									alt={`پیش‌نمایش ${item.name}`}
									loading="lazy"
								/>
								<figcaption class="media-tile__meta">
									<span class="media-tile__name ltr" dir="ltr">{item.name}</span>
									<span class="media-tile__size num">
										{faFileSize(item.bytes)} — {faDate(item.modifiedAt)}
									</span>
								</figcaption>
								<div class="media-tile__actions">
									<button
										class="btn btn--outline btn--sm grow"
										type="button"
										data-copy={item.reference}
										title="رونوشت مسیر برای استفاده در نوشته"
									>
										<Icon name="copy" size={13} />
										<span>رونوشت مسیر</span>
									</button>
									{canDeleteMedia && (
										<form
										method="post"
										action={`/cms/api/media/${encodeURIComponent(item.name)}`}
										data-confirm={`فایل «${item.name}» حذف شود؟`}
									>
										<button class="btn btn--danger btn--sm" type="submit" aria-label="حذف فایل">
											<Icon name="trash" size={13} />
										</button>
										</form>
									)}
								</div>
							</figure>
						))}
					</div>
					<Pagination page={uploadPage.page} pages={uploadPage.pages} total={uploadPage.total} perPage={uploadPage.perPage} baseUrl="/cms/media" params={{ q: query, builtinPage: builtinPage.page > 1 ? builtinPage.page : undefined }} label="فایل" navigationLabel="صفحه‌بندی بارگذاری‌ها" />
				</div>
			) : (
				<div class="empty">
					<span class="empty__icon"><Icon name="image" size={22} /></span>
					<span class="empty__title">{query ? 'فایلی با این نام پیدا نشد' : 'هنوز فایلی بارگذاری نکرده‌اید'}</span>
					<span>{query ? 'عبارت دیگری را جست‌وجو کنید.' : 'تصویر شاخص نوشته‌ها را از همین‌جا اضافه کنید.'}</span>
					{query && <a class="btn btn--outline btn--sm" href="/cms/media">پاک‌کردن جست‌وجو</a>}
				</div>
			)}
		</div>

		<div class="card">
			<div class="card__head">
				<div>
					<h2 class="card__title">تصاویر همراه قالب</h2>
					<p class="card__hint">فایل‌های موجود در src/assets که با پروژه نصب شده‌اند.</p>
				</div>
				<span class="badge badge--neutral">{faNumber(builtin.length)} فایل</span>
			</div>
			<div class="card__body">
				<div class="media-grid">
					{builtinPage.items.map((item) => (
						<figure class="media-tile">
							<span class="badge badge--neutral media-tile__badge">همراه قالب</span>
							<img
								class="media-tile__thumb"
								src={item.previewUrl}
								alt={`پیش‌نمایش ${item.name}`}
								loading="lazy"
							/>
							<figcaption class="media-tile__meta">
								<span class="media-tile__name ltr" dir="ltr">{item.name}</span>
								<span class="media-tile__size num">{faFileSize(item.bytes)}</span>
							</figcaption>
							<div class="media-tile__actions">
								<button class="btn btn--outline btn--sm grow" type="button" data-copy={item.reference}>
									<Icon name="copy" size={13} />
									<span>رونوشت مسیر</span>
								</button>
							</div>
						</figure>
					))}
				</div>
				<Pagination page={builtinPage.page} pages={builtinPage.pages} total={builtinPage.total} perPage={builtinPage.perPage} baseUrl="/cms/media" params={{ q: query, page: uploadPage.page > 1 ? uploadPage.page : undefined }} label="فایل" pageParam="builtinPage" navigationLabel="صفحه‌بندی تصاویر همراه قالب" />
			</div>
		</div>

		<p class="hint">
			برای استفاده در متن نوشته، مسیر فایل را رونوشت کنید و در مارک‌داون بگذارید:
			<code class="ltr">![توضیح تصویر](../../assets/uploads/نام-فایل.jpg)</code>
		</p>
	</section>
</CmsLayout>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-upload-form]');
	const input = document.querySelector<HTMLInputElement>('[data-file-input]');
	const submit = document.querySelector<HTMLButtonElement>('[data-upload-submit]');
	const label = document.querySelector<HTMLElement>('[data-dropzone-label]');
	const defaultLabel = label?.textContent?.trim() ?? '';

	const persianSize = (bytes: number) => {
		const units = ['بایت', 'کیلوبایت', 'مگابایت'];
		let value = bytes;
		let unit = 0;
		while (value >= 1024 && unit < units.length - 1) {
			value /= 1024;
			unit += 1;
		}
		return `${value.toFixed(unit === 0 ? 0 : 1).replace('.', '٫').replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[Number(d)])} ${units[unit]}`;
	};

	const showSelection = () => {
		const files = [...(input?.files ?? [])];
		if (!submit || !label) return;
		submit.hidden = files.length === 0;
		if (!files.length) {
			label.textContent = defaultLabel;
			return;
		}
		const total = files.reduce((sum, file) => sum + file.size, 0);
		label.textContent = `${files.length.toLocaleString('fa-IR')} فایل انتخاب شد — مجموع ${persianSize(total)}`;
	};

	input?.addEventListener('change', showSelection);

	form?.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		if (target.closest('button, [data-deduplicate-option], label[for="media-input"]') || target === input) return;
		input?.click();
	});

	['dragenter', 'dragover'].forEach((type) => {
		form?.addEventListener(type, (event) => {
			event.preventDefault();
			form.classList.add('is-active');
		});
	});

	['dragleave', 'drop'].forEach((type) => {
		form?.addEventListener(type, () => form.classList.remove('is-active'));
	});

	form?.addEventListener('drop', (event) => {
		event.preventDefault();
		if (!input) return;
		const dropped = (event as DragEvent).dataTransfer?.files;
		if (!dropped?.length) return;
		const transfer = new DataTransfer();
		for (const file of dropped) transfer.items.add(file);
		input.files = transfer.files;
		showSelection();
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!input?.files?.length || !submit) {
			input?.click();
			return;
		}

		submit.disabled = true;
		if (label) label.textContent = 'در حال بارگذاری…';

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { accept: 'application/json' },
				body: new FormData(form),
			});
			const payload = (await response.json()) as { ok?: boolean; message?: string; files?: Array<{ reused?: boolean }> };
			if (response.ok && payload.ok) {
				window.location.assign(`/cms/media?flash=${payload.files?.some((file) => file.reused) ? 'upload-reused' : 'uploaded'}`);
				return;
			}
			if (label) label.textContent = payload.message ?? 'بارگذاری ناموفق بود.';
		} catch {
			if (label) label.textContent = 'ارتباط با سرور برقرار نشد.';
		} finally {
			submit.disabled = false;
		}
	});


	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		button.addEventListener('click', async () => {
			const value = button.dataset.copy ?? '';
			try {
				await navigator.clipboard.writeText(value);
				const original = button.querySelector('span')?.textContent ?? 'رونوشت مسیر';
				const span = button.querySelector('span');
				if (span) span.textContent = 'رونوشت شد ✓';
				setTimeout(() => {
					if (span) span.textContent = original;
				}, 1800);
			} catch {
				window.prompt('مسیر فایل را رونوشت کنید:', value);
			}
		});
	});
</script>

---
import CmsLayout from '../../components/cms/CmsLayout.astro';
import Icon from '../../components/cms/Icon.astro';
import { faCompactMoney, faDate, faMoney, faNumber, faRelative } from '../../lib/cms/fa';
import { buildStats, listPosts } from '../../lib/cms/posts';
import { readSettings } from '../../lib/cms/settings';
import { buildDashboardMetrics } from '../../lib/commerce/stats';
import { orderStatusLabel, orderStatusTone } from '../../lib/commerce/types';
import { can } from '../../lib/cms/rbac';
import { applyFilters } from '../../lib/plugins/hooks';
import { ensurePluginsBooted } from '../../lib/plugins/registry';
import type { DashboardWidget } from '../../lib/plugins/types';

export const prerender = false;

const canEditSettings = can(Astro.locals.cmsUser?.role ?? 'subscriber', 'cms.settings:write');
const canBuildPages = can(Astro.locals.cmsUser?.role ?? 'subscriber', 'cms.pages:write');
const [posts, settings] = await Promise.all([listPosts(), readSettings()]);
const stats = buildStats(posts);
const commerce = settings.commerceEnabled;
const metrics = commerce ? await buildDashboardMetrics(14) : null;

const currency = settings.currency;
const maxBar = metrics ? Math.max(...metrics.series.map((point) => point.total), 1) : 1;
const dayLabel = new Intl.DateTimeFormat('fa-IR', { day: 'numeric' });
const seriesTotal = metrics ? metrics.series.reduce((sum, point) => sum + point.total, 0) : 0;
const hasRevenueData = seriesTotal > 0;

const pending = metrics?.pending ?? 0;
const lowStock = metrics?.lowStock ?? [];
const recentPosts = posts.slice(0, 5);

await ensurePluginsBooted();
const pluginWidgets = await applyFilters<DashboardWidget[]>('cms.dashboard.widgets', [], {
	posts,
});
const drafts = posts.filter((post) => post.draft).length;

const trend = (change: number | null) =>
	change === null ? 'trend trend--flat' : change > 0 ? 'trend trend--up' : change < 0 ? 'trend trend--down' : 'trend trend--flat';
---

<CmsLayout title="داشبورد" subtitle="نمای کلی محتوا و فروش">
	<Fragment slot="actions">
		{canBuildPages ? <a class="btn btn--sm" href="/cms/pages/new"><Icon name="grid" size={14} /><span>صفحهٔ تازه</span></a> : null}
		<a class="btn btn--sm" href="/cms/posts/new">
			<Icon name="plus" size={14} />
			<span>نوشتهٔ تازه</span>
		</a>
		{
			commerce && (
				<a class="btn btn--primary btn--sm" href="/cms/products/new">
					<Icon name="box" size={14} />
					<span>محصول تازه</span>
				</a>
			)
		}
	</Fragment>

	{
		commerce && metrics ? (
			<>
				<section class="metric-strip" aria-label="شاخص‌های فروش">
					<div class="metric-strip__item">
						<span class="metric-strip__label">درآمد ۳۰ روز گذشته</span>
						<strong class="metric-strip__value num">
							{faCompactMoney(metrics.revenue.current, currency)}
						</strong>
						<span class="metric-strip__foot">
							<span class={trend(metrics.revenue.change)}>
								<span class="num">{metrics.revenue.change === null ? '—' : `${faNumber(Math.abs(metrics.revenue.change))}٪`}</span>
							</span>
							<span>{metrics.revenue.change === null ? 'دورهٔ قبل مبنای مقایسه ندارد' : 'نسبت به دورهٔ قبل'}</span>
						</span>
					</div>

					<div class="metric-strip__item">
						<span class="metric-strip__label">سفارش‌ها</span>
						<strong class="metric-strip__value num">{faNumber(metrics.orders.current)}</strong>
						<span class="metric-strip__foot">
							<span class={trend(metrics.orders.change)}>
								<span class="num">{metrics.orders.change === null ? '—' : `${faNumber(Math.abs(metrics.orders.change))}٪`}</span>
							</span>
							<span>{metrics.orders.change === null ? 'دورهٔ قبل مبنای مقایسه ندارد' : 'نسبت به دورهٔ قبل'}</span>
							<span>{faNumber(pending)} در انتظار پرداخت</span>
						</span>
					</div>

					<div class="metric-strip__item">
						<span class="metric-strip__label">میانگین سبد خرید</span>
						<strong class="metric-strip__value num">
							{metrics.paidOrderCount > 0 ? faCompactMoney(metrics.averageOrder, currency) : '—'}
						</strong>
						<span class="metric-strip__foot">
							<span>
								{metrics.paidOrderCount > 0
									? `${faNumber(metrics.customers)} مشتری ثبت‌شده`
									: 'پس از نخستین پرداخت تأییدشده محاسبه می‌شود'}
							</span>
						</span>
					</div>

					<div class="metric-strip__item">
						<span class="metric-strip__label">محصولات فعال</span>
						<strong class="metric-strip__value num">{faNumber(metrics.activeProducts)}</strong>
						<span class="metric-strip__foot">
							{metrics.activeProducts === 0 ? (
								<span>محصول فعالی ندارید</span>
							) : metrics.outOfStock > 0 ? (
								<span style="color:var(--danger)">
									{faNumber(metrics.outOfStock)} ناموجود
								</span>
							) : (
								<span>محصولات فعال موجودند</span>
							)}
						</span>
					</div>
				</section>

				<div class="split">
					<div class="stack">
						<section class="card">
							<div class="card__head">
								<div>
									<h2 class="card__title">روند درآمد</h2>
									<p class="card__hint">
										۱۴ روز گذشته — مجموع {faMoney(seriesTotal, currency)}
									</p>
								</div>
								<span class="badge badge--neutral">پرداخت‌های تأییدشده</span>
							</div>
											{hasRevenueData ? (
												<div class="card__body">
													<div
														class="chart"
														role="img"
														aria-label={`نمودار درآمد ۱۴ روز گذشته، مجموع ${faMoney(seriesTotal, currency)}`}
													>
														{metrics.series.map((point, index) => (
															<div
																class="chart__col"
																title={`${faDate(point.date)} — ${faMoney(point.total, currency)}`}
															>
																<div
																	class:list={['chart__bar', point.total === 0 && 'chart__bar--muted']}
																	style={`height:${point.total === 0 ? 0 : Math.max(3, Math.round((point.total / maxBar) * 100))}%`}
																/>
																<span class="chart__label num">
																	{index % 2 === 0 ? dayLabel.format(new Date(point.date)) : ''}
																</span>
															</div>
														))}
													</div>
												</div>
											) : (
												<div class="empty" role="status">
													<span class="empty__icon"><Icon name="chart" size={20} /></span>
													<span class="empty__title">در ۱۴ روز گذشته درآمدی ثبت نشده است</span>
													<span>نمودار با سفارش‌های دارای پرداخت تأییدشده پر می‌شود؛ داده‌ای ساخته یا تخمین زده نمی‌شود.</span>
													<a class="btn btn--sm btn--ghost" href="/cms/orders">بررسی سفارش‌ها</a>
												</div>
											)}
							</section>

						<section class="card">
							<div class="card__head">
								<h2 class="card__title">سفارش‌های اخیر</h2>
								<a class="btn btn--ghost btn--sm" href="/cms/orders">همهٔ سفارش‌ها</a>
							</div>

							{metrics.recentOrders.length ? (
								<div class="table-wrap">
									<table class="table">
										<thead>
											<tr>
												<th scope="col">سفارش</th>
												<th scope="col">مشتری</th>
												<th scope="col">مبلغ</th>
												<th scope="col">وضعیت</th>
												<th scope="col">زمان</th>
											</tr>
										</thead>
										<tbody>
											{metrics.recentOrders.map((order) => (
												<tr>
													<td>
														<a class="table__title num" href={`/cms/orders/${order.id}`}>
															{order.number}
														</a>
													</td>
													<td class="truncate">{order.customerName}</td>
													<td class="num nowrap">{faMoney(order.total, currency)}</td>
													<td>
														<span class={`badge badge--${orderStatusTone(order.status)}`}>
															{orderStatusLabel(order.status)}
														</span>
													</td>
													<td class="num nowrap muted">{faRelative(order.createdAt)}</td>
												</tr>
											))}
										</tbody>
									</table>
								</div>
							) : (
								<div class="empty">
									<span class="empty__icon"><Icon name="receipt" size={20} /></span>
									<span class="empty__title">هنوز سفارشی ثبت نشده است</span>
									<span>پس از ثبت سفارش، جزئیات واقعی آن در این بخش نمایش داده می‌شود.</span>
								</div>
							)}
						</section>
					</div>

					<div class="stack">
						<section class="card">
							<div class="card__head">
								<h2 class="card__title">نیاز به رسیدگی</h2>
							</div>
							<ul class="list">
								<li>
									<a class="list__row" href="/cms/orders?status=pending">
										<span class="list__main">
											<span class="list__title">سفارش در انتظار پرداخت</span>
											<span class="list__meta">بررسی وضعیت پرداخت</span>
										</span>
										<span class={pending > 0 ? 'badge badge--warning num' : 'badge badge--neutral num'}>
											{faNumber(pending)}
										</span>
									</a>
								</li>
								<li>
									<a class="list__row" href="/cms/products?sort=stock-asc">
										<span class="list__main">
											<span class="list__title">محصول ناموجود</span>
											<span class="list__meta">شارژ موجودی یا بایگانی</span>
										</span>
										<span
											class={metrics.outOfStock > 0 ? 'badge badge--danger num' : 'badge badge--neutral num'}
										>
											{faNumber(metrics.outOfStock)}
										</span>
									</a>
								</li>
								<li>
									<a class="list__row" href="/cms/posts?status=draft">
										<span class="list__main">
											<span class="list__title">نوشتهٔ پیش‌نویس</span>
											<span class="list__meta">آمادهٔ بازبینی و انتشار</span>
										</span>
										<span class={drafts > 0 ? 'badge badge--warning num' : 'badge badge--neutral num'}>
											{faNumber(drafts)}
										</span>
									</a>
								</li>
							</ul>
						</section>

						<section class="card">
							<div class="card__head">
								<h2 class="card__title">کم‌موجودی</h2>
								<a class="btn btn--ghost btn--sm" href="/cms/products">انبار</a>
							</div>
							{lowStock.length ? (
								<ul class="list">
									{lowStock.slice(0, 5).map((product) => (
										<li>
											<a class="list__row" href={`/cms/products/${product.id}`}>
												<span class="list__main">
													<span class="list__title">{product.name}</span>
													<span class="list__meta ltr">{product.sku}</span>
												</span>
												<span
													class:list={[
														'list__value',
														product.stock === 0 ? 'stock--out' : 'stock--low',
													]}
												>
													{product.stock === 0 ? 'ناموجود' : `${faNumber(product.stock)} عدد`}
												</span>
											</a>
										</li>
									))}
								</ul>
							) : (
								<p class="hint" style="padding:12px 16px">
									{metrics.activeProducts === 0
									? 'محصول فعالی برای پایش موجودی وجود ندارد.'
									: 'موجودی محصولات فعال بالاتر از حد هشدار است.'}
								</p>
							)}
						</section>

						<section class="card">
							<div class="card__head">
								<h2 class="card__title">آخرین نوشته‌ها</h2>
								<a class="btn btn--ghost btn--sm" href="/cms/posts">همه</a>
							</div>
							{recentPosts.length ? (
								<ul class="list">
									{recentPosts.map((post) => (
										<li>
											<a class="list__row" href={`/cms/posts/${post.id}`}>
												<span class="list__main">
													<span class="list__title">{post.title}</span>
													<span class="list__meta num">
														{faRelative(post.modifiedAt)} — {faNumber(post.words)} واژه
													</span>
												</span>
												{post.draft && <span class="badge badge--warning">پیش‌نویس</span>}
											</a>
										</li>
									))}
								</ul>
							) : (
								<div class="empty" style="padding:24px">
									<span class="empty__title">هنوز نوشته‌ای نیست</span>
									<a class="btn btn--sm" href="/cms/posts/new" style="margin-top:8px">
										نوشتن اولین نوشته
									</a>
								</div>
							)}
						</section>

						{pluginWidgets.map((widget) => (
							<section class="card">
								<div class="card__head">
									<h2 class="card__title">{widget.title}</h2>
								</div>
								<Fragment set:html={widget.html} />
							</section>
						))}
					</div>
				</div>
			</>
		) : (
			<>
				<section class="metric-strip" aria-label="شاخص‌های محتوا">
					<div class="metric-strip__item">
						<span class="metric-strip__label">نوشته‌ها</span>
						<strong class="metric-strip__value num">{faNumber(stats.total)}</strong>
						<span class="metric-strip__foot">{faNumber(stats.published)} منتشرشده</span>
					</div>
					<div class="metric-strip__item">
						<span class="metric-strip__label">پیش‌نویس</span>
						<strong class="metric-strip__value num">{faNumber(stats.drafts)}</strong>
						<span class="metric-strip__foot">در انتظار بازبینی</span>
					</div>
					<div class="metric-strip__item">
						<span class="metric-strip__label">واژه‌های نوشته‌شده</span>
						<strong class="metric-strip__value num">{faNumber(stats.words)}</strong>
						<span class="metric-strip__foot">
							{stats.total
								? `میانگین ${faNumber(Math.round(stats.words / stats.total))} واژه در هر نوشته`
								: 'پس از ایجاد نوشته محاسبه می‌شود'}
						</span>
					</div>
					<div class="metric-strip__item">
						<span class="metric-strip__label">برچسب‌ها</span>
						<strong class="metric-strip__value num">{faNumber(stats.tags.length)}</strong>
						<span class="metric-strip__foot">
							{stats.tags.length ? `پرکاربردترین: ${stats.tags[0].name}` : 'بدون برچسب'}
						</span>
					</div>
				</section>

				<div class="split">
					<section class="card">
						<div class="card__head">
							<h2 class="card__title">آخرین نوشته‌ها</h2>
							<a class="btn btn--ghost btn--sm" href="/cms/posts">همهٔ نوشته‌ها</a>
						</div>
						{recentPosts.length ? (
							<div class="table-wrap">
								<table class="table">
									<thead>
										<tr>
											<th scope="col">عنوان</th>
											<th scope="col">وضعیت</th>
											<th scope="col">انتشار</th>
											<th scope="col">واژه</th>
										</tr>
									</thead>
									<tbody>
										{recentPosts.map((post) => (
											<tr>
												<td>
													<a class="table__title" href={`/cms/posts/${post.id}`}>
														{post.title}
													</a>
												</td>
												<td>
													<span class={`badge badge--${post.draft ? 'warning' : 'success'}`}>
														{post.draft ? 'پیش‌نویس' : 'منتشرشده'}
													</span>
												</td>
												<td class="num nowrap">{faDate(post.pubDate)}</td>
												<td class="num nowrap">{faNumber(post.words)}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						) : (
							<div class="empty">
								<span class="empty__title">هنوز نوشته‌ای ثبت نشده است</span>
								<a class="btn btn--primary btn--sm" href="/cms/posts/new" style="margin-top:8px">
									نوشتهٔ تازه
								</a>
							</div>
						)}
					</section>

					<div class="stack">
						<section class="card">
							<div class="card__head">
								<h2 class="card__title">فروشگاه</h2>
							</div>
							<div class="card__body" style="display:flex;flex-direction:column;gap:8px">
								<p class="hint">
									ماژول فروشگاه خاموش است. با فعال‌کردن آن، محصولات، سفارش‌ها، مشتریان و
									کدهای تخفیف به پنل اضافه می‌شوند.
								</p>
								{canEditSettings && <a class="btn btn--sm" href="/cms/settings">رفتن به تنظیمات</a>}
							</div>
						</section>

						<section class="card">
							<div class="card__head">
								<h2 class="card__title">برچسب‌ها</h2>
							</div>
							<div class="card__body">
								{stats.tags.length ? (
									<ul class="tag-list">
										{stats.tags.map((tag) => (
											<li>
												<a class="badge" href={`/cms/posts?tag=${encodeURIComponent(tag.name)}`}>
													#{tag.name}
													<span class="num">{faNumber(tag.count)}</span>
												</a>
											</li>
										))}
									</ul>
								) : (
									<p class="hint">با افزودن برچسب به نوشته‌ها، این بخش پر می‌شود.</p>
								)}
							</div>
						</section>
					</div>
				</div>
			</>
		)
	}
</CmsLayout>

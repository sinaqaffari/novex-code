---
import CmsLayout from '../../../components/cms/CmsLayout.astro';
import Icon from '../../../components/cms/Icon.astro';
import Pagination from '../../../components/cms/Pagination.astro';
import { faDate, faNumber, faReadingTime, faRelative } from '../../../lib/cms/fa';
import { listPosts } from '../../../lib/cms/posts';
import { filterPosts, paginate, type PostStatusFilter } from '../../../lib/cms/listing';
import { can } from '../../../lib/cms/rbac';

export const prerender = false;

const role = Astro.locals.cmsUser?.role ?? 'subscriber';
const canWritePosts = can(role, 'cms.posts:write');
const canPublishPosts = can(role, 'cms.posts:publish');
const canDeletePosts = can(role, 'cms.posts:delete');
const allPosts = await listPosts();
const posts = canWritePosts ? allPosts : allPosts.filter((post) => !post.draft);
const tagFilter = Astro.url.searchParams.get('tag') ?? '';
const query = (Astro.url.searchParams.get('q') ?? '').trim();
const rawStatus = Astro.url.searchParams.get('status');
const status: PostStatusFilter = canWritePosts && (rawStatus === 'draft' || rawStatus === 'published') ? rawStatus : 'all';
const result = paginate(filterPosts(posts, { tag: tagFilter, query, status }), Number(Astro.url.searchParams.get('page') ?? 1), 20);
const published = posts.filter((post) => !post.draft).length;
const drafts = posts.length - published;
const statusHref = (value: PostStatusFilter, includeTag = true) => {
	const params = new URLSearchParams();
	if (query) params.set('q', query);
	if (includeTag && tagFilter) params.set('tag', tagFilter);
	if (value !== 'all') params.set('status', value);
	return params.size ? `/cms/posts?${params}` : '/cms/posts';
};
---

<CmsLayout
	title="نوشته‌ها"
	subtitle={`${faNumber(posts.length)} نوشته در مخزن محتوا — ${faNumber(published)} منتشرشده و ${faNumber(drafts)} پیش‌نویس`}
>
	<Fragment slot="actions">
		{canWritePosts ? <a class="btn btn--primary btn--sm" href="/cms/posts/new"><Icon name="plus" size={15} /><span>نوشتهٔ تازه</span></a> : null}
	</Fragment>

	<section class="card">
		<div class="card__head">
			<div class="filterbar">
				{canWritePosts && (
					<nav class="segmented" aria-label="پالایش بر اساس وضعیت">
						<a href={statusHref('all')} aria-current={status === 'all' ? 'page' : undefined}>همه <span class="segmented__count num">{faNumber(posts.length)}</span></a>
						<a href={statusHref('published')} aria-current={status === 'published' ? 'page' : undefined}>منتشرشده <span class="segmented__count num">{faNumber(published)}</span></a>
						<a href={statusHref('draft')} aria-current={status === 'draft' ? 'page' : undefined}>پیش‌نویس <span class="segmented__count num">{faNumber(drafts)}</span></a>
					</nav>
				)}
				<form class="toolbar posts-search" method="get" action="/cms/posts" role="search">
					{status !== 'all' && <input type="hidden" name="status" value={status} />}
					{tagFilter && <input type="hidden" name="tag" value={tagFilter} />}
					<label class="search">
						<span class="sr-only">جست‌وجو در نوشته‌ها</span>
						<Icon name="search" size={16} />
						<input class="input" type="search" name="q" value={query} placeholder="عنوان، نامک یا برچسب…" autocomplete="off" />
					</label>
					<button class="btn btn--outline btn--sm" type="submit">جست‌وجو</button>
				</form>
				{tagFilter && <a class="badge badge--brand" href={statusHref(status, false)}>برچسب: {tagFilter} ✕</a>}
			</div>
		</div>
		{result.total ? (
			<div class="card__body card__body--flush">
				<div class="table-wrap">
					<table class="table posts-table">
						<thead>
							<tr>
								<th scope="col">عنوان</th>
								<th scope="col">وضعیت</th>
								<th scope="col">برچسب‌ها</th>
								<th scope="col">انتشار</th>
								<th scope="col">واژه‌ها</th>
								<th scope="col">آخرین تغییر</th>
								<th scope="col"><span class="sr-only">عملیات</span></th>
							</tr>
						</thead>
						<tbody data-post-rows>
							{result.items.map((post) => (
								<tr
									data-post-row
									data-status={post.draft ? 'draft' : 'published'}
									data-search={`${post.title} ${post.slug} ${post.tags.join(' ')}`.toLowerCase()}
								>
									<td>
										{canWritePosts && (post.draft || canPublishPosts) ? (
											<a class="table__title" href={`/cms/posts/${post.id}`}>{post.title}</a>
										) : (
											<span class="table__title">{post.title}</span>
										)}
										<code class="table__slug ltr">/blog/{post.slug}</code>
									</td>
									<td>
										{post.draft ? (
											<span class="badge badge--warning">
												<span class="badge__dot" />
												پیش‌نویس
											</span>
										) : (
											<span class="badge badge--success">
												<span class="badge__dot" />
												منتشرشده
											</span>
										)}
									</td>
									<td>
										{post.tags.length ? (
											<ul class="tag-list">
												{post.tags.slice(0, 3).map((tag) => (
													<li class="badge badge--neutral">#{tag}</li>
												))}
											</ul>
										) : (
											<span class="muted">—</span>
										)}
									</td>
									<td class="num" style="white-space:nowrap">{faDate(post.pubDate)}</td>
									<td class="num" style="white-space:nowrap">
										{faNumber(post.words)}
										<span class="hint" style="display:block">{faReadingTime(post.words)}</span>
									</td>
									<td class="num" style="white-space:nowrap">{faRelative(post.modifiedAt)}</td>
									<td>
										<div class="table__actions">
											<a
												class="btn btn--ghost btn--sm"
												href={`/blog/${post.slug}`}
												target="_blank"
												rel="noreferrer"
												aria-label={`مشاهدهٔ ${post.title} در سایت`}
											>
												<Icon name="eye" size={15} />
											</a>
											{canWritePosts && (post.draft || canPublishPosts) ? <a class="btn btn--outline btn--sm" href={`/cms/posts/${post.id}`}><Icon name="edit" size={14} /><span>ویرایش</span></a> : null}
											{canDeletePosts ? <form method="post" action={`/cms/api/posts/${post.id}?action=delete`} data-confirm={`نوشتهٔ «${post.title}» برای همیشه حذف شود؟ این کار بازگشت‌پذیر نیست.`}><button class="btn btn--ghost btn--sm" type="submit" aria-label="حذف نوشته"><Icon name="trash" size={15} /></button></form> : null}
										</div>
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<Pagination page={result.page} pages={result.pages} total={result.total} perPage={result.perPage} baseUrl="/cms/posts" params={{ q: query, status: status === 'all' ? '' : status, tag: tagFilter }} label="نوشته" />
			</div>
		) : (
			<div class="empty">
				<span class="empty__icon"><Icon name="posts" size={22} /></span>
				<span class="empty__title">{query || tagFilter || status !== 'all' ? 'نتیجه‌ای پیدا نشد' : 'هنوز نوشته‌ای ندارید'}</span>
				<span>{query || tagFilter || status !== 'all' ? 'عبارت یا پالایهٔ دیگری را امتحان کنید.' : canWritePosts ? 'اولین مقاله را بسازید؛ همه‌چیز از همین‌جا شروع می‌شود.' : 'در حال حاضر نوشتهٔ منتشرشده‌ای برای نمایش نیست.'}</span>
				{query || tagFilter || status !== 'all' ? <a class="btn btn--outline" href="/cms/posts">پاک‌کردن پالایه‌ها</a> : canWritePosts ? <a class="btn btn--primary" href="/cms/posts/new"><Icon name="plus" size={15} /><span>نوشتهٔ تازه</span></a> : null}
			</div>
		)}
	</section>

	<p class="hint">
		نکته: نامک هر نوشته آدرس عمومی آن را می‌سازد (<code class="ltr">/blog/…</code>). تغییر نامک،
		نشانی صفحه را عوض می‌کند؛ پس از تغییر، پیوندهای قدیمی را به‌روزرسانی کنید.
	</p>
</CmsLayout>

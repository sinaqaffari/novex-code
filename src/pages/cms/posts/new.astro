---
import CmsLayout from '../../../components/cms/CmsLayout.astro';
import Icon from '../../../components/cms/Icon.astro';
import PostEditor from '../../../components/cms/PostEditor.astro';
import { listMedia } from '../../../lib/cms/media';
import { can } from '../../../lib/cms/rbac';

export const prerender = false;

const media = await listMedia({ dimensions: false });
const role = Astro.locals.cmsUser?.role ?? 'subscriber';
const canPublish = can(role, 'cms.posts:publish');
const canManageMedia = can(role, 'cms.media:write');
---

<CmsLayout title="نوشتهٔ تازه" subtitle="یک مقالهٔ جدید بسازید — میتوانید آن را پیشنویس نگه دارید و بعداً منتشر کنید.">
	<Fragment slot="actions">
		<a class="btn btn--outline btn--sm" href="/cms/posts">
			<Icon name="arrow" size={15} />
			<span>بازگشت به فهرست</span>
		</a>
	</Fragment>

	<PostEditor mode="new" media={media} canPublish={canPublish} canManageMedia={canManageMedia} />
</CmsLayout>

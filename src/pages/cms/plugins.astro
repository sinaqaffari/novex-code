<script>
	import { validateDeclarativePluginPackage, type DeclarativePluginPackage } from '../../lib/builder/declarative-plugin-package.ts';
	const input = document.getElementById('data-plugin-file');
	const summary = document.getElementById('data-plugin-summary');
	const status = document.getElementById('data-plugin-status');
	const readme = document.getElementById('data-plugin-readme');
	const install = document.getElementById('data-plugin-install');
	const update = document.getElementById('data-plugin-update');
	let candidate: DeclarativePluginPackage | null = null;
	let candidateArchive: File | null = null;
	let sending = false;
	let inspection = 0;
	const rowFor = (id: string) => Array.from(document.querySelectorAll<HTMLElement>('[data-data-plugin-id]')).find((row) => row.dataset.dataPluginId === id);
	const message = (value: string) => { if (status) status.textContent = value; };
	const setButtons = () => {
		if (install instanceof HTMLButtonElement) install.disabled = sending || !candidate || Boolean(rowFor(candidate.id));
		if (update instanceof HTMLButtonElement) update.disabled = sending || !candidate || !rowFor(candidate.id);
	};
	input?.addEventListener('change', async () => {
		const current = ++inspection;
		candidate = null; candidateArchive = null; message(''); setButtons();
		if (readme) { readme.textContent = ''; readme.hidden = true; }
		const file = input instanceof HTMLInputElement ? input.files?.[0] : undefined;
		if (!file) return;
		try {
			let parsed: unknown;
			let guide = '';
			let assetCount = 0;
			if (file.name.toLowerCase().endsWith('.zip')) {
				if (file.size > 12 * 1024 * 1024) throw new Error('حجم ZIP نباید بیش از ۱۲ مگابایت باشد.');
				const form = new FormData(); form.set('archive', file);
				const response = await fetch('/cms/api/builder/plugin-archive', { method: 'POST', headers: { accept: 'application/json' }, body: form });
				const result: unknown = await response.json();
				if (!result || typeof result !== 'object' || !('ok' in result) || result.ok !== true || !('package' in result) || !response.ok) throw new Error(result && typeof result === 'object' && 'message' in result && typeof result.message === 'string' ? result.message : 'بستهٔ ZIP معتبر نیست.');
				parsed = result.package;
				if ('readme' in result && typeof result.readme === 'string') guide = result.readme;
				if (!('assetCount' in result) || typeof result.assetCount !== 'number' || !Number.isSafeInteger(result.assetCount) || result.assetCount < 0) throw new Error('پاسخ دارایی‌های بسته معتبر نیست.');
				assetCount = result.assetCount;
			} else {
				if (file.size > 500_000) throw new Error('حجم JSON نباید بیش از ۵۰۰ کیلوبایت باشد.');
				parsed = JSON.parse(await file.text());
			}
			const valid = validateDeclarativePluginPackage(parsed);
			if (current !== inspection) return;
			candidate = valid; candidateArchive = file.name.toLowerCase().endsWith('.zip') ? file : null;
			if (summary) summary.textContent = `${candidate.name} · ${candidate.id} · نسخهٔ ${candidate.version} · ${candidate.components.length} مؤلفه · ${candidate.presets?.length ?? 0} پیش‌تنظیم · ${candidate.processors?.length ?? 0} پردازشگر ایزوله · ${assetCount} تصویر بسته`;
			if (readme && guide) { readme.textContent = guide; readme.hidden = false; }
			setButtons();
		} catch (error) { if (current === inspection && summary) summary.textContent = error instanceof Error ? error.message : 'فایل معتبر نیست.'; }
	});
	async function send(method: string, payload: unknown) {
		if (sending) return; sending = true; setButtons();
		message('در حال بررسی…');
		try {
			const response = await fetch('/cms/api/builder/plugin-packages', { method, headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(payload) });
			const result: unknown = await response.json();
			if (!response.ok) throw new Error(result && typeof result === 'object' && 'message' in result && typeof result.message === 'string' ? result.message : 'عملیات انجام نشد.');
			if (!result || typeof result !== 'object' || !('ok' in result) || result.ok !== true) throw new Error('پاسخ موفق سرور معتبر نیست؛ وضعیت بسته را دوباره بررسی کنید.');
			if (method === 'POST') {
				if (!('record' in result) || !result.record || typeof result.record !== 'object' || !('revision' in result.record) || !Number.isSafeInteger(result.record.revision) || !('package' in result.record)) throw new Error('پاسخ نصب معتبر نیست؛ وضعیت بسته را دوباره بررسی کنید.');
				const installed = validateDeclarativePluginPackage(result.record.package);
				if (!candidate || installed.id !== candidate.id || installed.version !== candidate.version) throw new Error('پاسخ نصب با بستهٔ انتخاب‌شده تطابق ندارد.');
			}
			window.location.reload();
		} catch (error) { message(error instanceof Error ? error.message : 'عملیات انجام نشد.'); }
		finally { sending = false; setButtons(); }
	}
	async function sendArchive(action: 'install' | 'update', file: File, expectedRevision?: number) {
		if (sending || !candidate) return; sending = true; setButtons(); message('در حال نصب بسته…');
		try {
			const form = new FormData(); form.set('archive', file); form.set('action', action); form.set('confirm', 'true');
			if (expectedRevision !== undefined) form.set('expectedRevision', String(expectedRevision));
			const response = await fetch('/cms/api/builder/plugin-archive', { method: 'POST', headers: { accept: 'application/json' }, body: form });
			const result: unknown = await response.json();
			if (!response.ok) throw new Error(result && typeof result === 'object' && 'message' in result && typeof result.message === 'string' ? result.message : 'نصب بسته ممکن نشد.');
			if (!result || typeof result !== 'object' || !('ok' in result) || result.ok !== true || !('record' in result) || !result.record || typeof result.record !== 'object' || !('revision' in result.record) || !Number.isSafeInteger(result.record.revision) || !('package' in result.record)) throw new Error('پاسخ نصب معتبر نیست؛ وضعیت بسته را دوباره بررسی کنید.');
			const installed = validateDeclarativePluginPackage(result.record.package);
			if (installed.id !== candidate.id || installed.version !== candidate.version) throw new Error('پاسخ نصب با بستهٔ انتخاب‌شده تطابق ندارد.');
			window.location.reload();
		} catch (error) { message(error instanceof Error ? error.message : 'نصب بسته ممکن نشد.'); }
		finally { sending = false; setButtons(); }
	}
	install?.addEventListener('click', () => {
		if (candidate && window.confirm(candidate.processors?.length ? 'پردازشگرهای WebAssembly این بسته فقط هنگام درخواست در محیط ایزوله اجرا می‌شوند؛ JavaScript افزونه اجرا نمی‌شود. ادامه می‌دهید؟' : 'بستهٔ داده‌محور فعال می‌شود؛ هیچ کدی روی سرور اجرا نمی‌شود. ادامه می‌دهید؟')) {
			if (candidateArchive) void sendArchive('install', candidateArchive);
			else void send('POST', { action: 'install', confirm: true, package: candidate });
		}
	});
	update?.addEventListener('click', () => {
		const row = candidate ? rowFor(candidate.id) : undefined;
		if (candidate && row && window.confirm(candidate.processors?.length ? 'بسته شامل پردازشگر WebAssembly ایزوله است؛ مؤلفه‌های درج‌شده تغییر نمی‌کنند. ادامه می‌دهید؟' : 'مؤلفه‌های تازه برای درج آماده می‌شوند؛ نسخه‌های درج‌شده تغییر نمی‌کنند. ادامه می‌دهید؟')) {
			if (candidateArchive) void sendArchive('update', candidateArchive, Number(row.dataset.revision));
			else void send('POST', { action: 'update', confirm: true, package: candidate, expectedRevision: Number(row.dataset.revision) });
		}
	});
	document.querySelectorAll<HTMLButtonElement>('[data-data-plugin-toggle], [data-data-plugin-delete]').forEach((button) => button.addEventListener('click', () => {
		const row = button.closest<HTMLElement>('[data-data-plugin-id]');
		if (!row?.dataset.dataPluginId) return;
		const base = { id: row.dataset.dataPluginId, expectedRevision: Number(row.dataset.revision) };
		if (button.hasAttribute('data-data-plugin-delete')) {
			if (window.confirm('بسته حذف می‌شود؛ نسخه‌های درج‌شده در صفحه‌ها باقی می‌مانند. ادامه می‌دهید؟')) void send('DELETE', { ...base, confirm: true });
		} else void send('PATCH', { ...base, active: button.dataset.active !== 'true' });
	}));
</script>


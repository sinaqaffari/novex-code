{
  "id": "hello",
  "apiVersion": 1,
  "name": "سلام دنیا",
  "version": "1.0.0",
  "description": "یک افزونهٔ نمونه.",
  "capabilities": ["site:render"],
  "license": "MIT",
  "requires": "2.0.0",
  "testedUpTo": "2.0.0",

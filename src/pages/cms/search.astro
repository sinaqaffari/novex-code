---
import CmsLayout from '../../components/cms/CmsLayout.astro';
import Icon from '../../components/cms/Icon.astro';
import { faDate, faMoney, faNumber } from '../../lib/cms/fa';
import { listPosts } from '../../lib/cms/posts';
import { requestCommerce, requestSettings } from '../../lib/cms/request-data';
import { normalizeSearch } from '../../lib/cms/listing';
import { can } from '../../lib/cms/rbac';
import { orderStatusLabel, orderStatusTone, productStatusLabel } from '../../lib/commerce/types';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const needle = normalizeSearch(query);
const role = Astro.locals.cmsUser?.role ?? 'subscriber';
const canWritePosts = can(role, 'cms.posts:write');
const canPublishPosts = can(role, 'cms.posts:publish');
const canWriteProducts = can(role, 'commerce.products:write');
const settings = await requestSettings(Astro.locals);
let commerceUnavailable = false;
const [posts, db] = await Promise.all([
	needle && can(role, 'cms.posts:read') ? listPosts() : Promise.resolve([]),
	needle && settings.commerceEnabled && (can(role, 'commerce.products:read') || can(role, 'commerce.orders:read'))
		? requestCommerce(Astro.locals).catch(() => { commerceUnavailable = true; return null; }) : Promise.resolve(null),
]);

const matchedPosts = needle
	? posts.filter((post) => (canWritePosts || !post.draft) &&
			normalizeSearch(`${post.title} ${post.description} ${post.tags.join(' ')} ${post.slug}`).includes(needle))
	: [];
const matchedProducts = needle && db && can(role, 'commerce.products:read')
	? db.products.filter((product) => (canWriteProducts || product.status === 'active') &&
			normalizeSearch(`${product.name} ${product.sku} ${product.category} ${product.slug}`).includes(needle))
	: [];
const matchedOrders = needle && db && can(role, 'commerce.orders:read')
	? db.orders.filter((order) =>
			normalizeSearch(`${order.number} ${order.customerName} ${order.phone} ${order.email}`).includes(needle))
	: [];

const total = matchedPosts.length + matchedProducts.length + matchedOrders.length;
const resultLimit = 20;
const searchParam = new URLSearchParams({ q: query }).toString();
---

<CmsLayout
	title={query ? `نتایج جست‌وجو برای «${query}»` : 'جست‌وجو'}
	subtitle={query ? `${faNumber(total)} نتیجه در بخش‌های قابل دسترس${commerceUnavailable ? '؛ فروشگاه بررسی نشد' : ''}` : 'در همهٔ بخش‌های پنل جست‌وجو کنید.'}
>
	<section class="card">
		<div class="card__body">
			<form method="get" action="/cms/search" class="toolbar" role="search">
				<label class="search grow" style="max-width:none">
					<span class="sr-only">عبارت جست‌وجو</span>
					<Icon name="search" size={16} />
					<input
						class="input"
						type="search"
						name="q"
						value={query}
						placeholder="عنوان نوشته، نام محصول، شمارهٔ سفارش…"
						autofocus
					/>
				</label>
				<button class="btn btn--primary btn--sm" type="submit">
					<span>جست‌وجو</span>
				</button>
			</form>
		</div>
	</section>

	{
		!query ? (
			<div class="empty">
				<span class="empty__icon">
					<Icon name="search" size={22} />
				</span>
				<span class="empty__title">عبارتی برای جست‌وجو بنویسید</span>
				<span>
					می‌توانید با <kbd>Ctrl</kbd> + <kbd>K</kbd> از هر جای پنل این کادر را باز کنید.
				</span>
			</div>
		) : total === 0 ? (
			<div class="empty">
				<span class="empty__icon">
					<Icon name="alert" size={22} />
				</span>
				<span class="empty__title">نتیجه‌ای پیدا نشد</span>
				<span>{commerceUnavailable ? 'نتیجه‌ای در محتوای قابل دسترس نیست؛ جست‌وجوی فروشگاه انجام نشد.' : 'املای عبارت را بررسی کنید یا بخش دیگری را جست‌وجو کنید.'}</span>
			</div>
		) : (
			<div class="stack">
				{matchedPosts.length > 0 && (
					<section class="card">
						<div class="card__head">
							<div>
								<h2 class="card__title">نوشته‌ها</h2>
								<p class="card__hint">{faNumber(matchedPosts.length)} نتیجه {(matchedPosts.length > resultLimit) && <a href={`/cms/posts?${searchParam}`}>— نمایش همه در فهرست</a>}</p>
							</div>
							<Icon name="posts" size={18} />
						</div>
						<div class="table-wrap">
							<table class="table">
								<tbody>
									{matchedPosts.slice(0, resultLimit).map((post) => (
										<tr>
											<td>
												{canWritePosts && (post.draft || canPublishPosts) ? (
													<a class="table__title" href={`/cms/posts/${post.id}`}>{post.title}</a>
												) : <span class="table__title">{post.title}</span>}
												<span class="table__slug ltr">/blog/{post.slug}</span>
											</td>
											<td class="num nowrap">{faDate(post.pubDate)}</td>
											<td>
												<span class={`badge badge--${post.draft ? 'warning' : 'success'}`}>
													{post.draft ? 'پیش‌نویس' : 'منتشرشده'}
												</span>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{settings.commerceEnabled && matchedProducts.length > 0 && (
					<section class="card">
						<div class="card__head">
							<div>
								<h2 class="card__title">محصولات</h2>
								<p class="card__hint">{faNumber(matchedProducts.length)} نتیجه {(matchedProducts.length > resultLimit) && <a href={`/cms/products?${searchParam}`}>— نمایش همه در فهرست</a>}</p>
							</div>
							<Icon name="box" size={18} />
						</div>
						<div class="table-wrap">
							<table class="table">
								<tbody>
									{matchedProducts.slice(0, resultLimit).map((product) => (
										<tr>
											<td>
												{canWriteProducts ? <a class="table__title" href={`/cms/products/${product.id}`}>{product.name}</a> : <span class="table__title">{product.name}</span>}
												<span class="table__slug ltr">{product.sku}</span>
											</td>
											<td class="num nowrap">{faMoney(product.price, settings.currency)}</td>
											<td>
												<span class="badge badge--neutral">
													{productStatusLabel(product.status)}
												</span>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{settings.commerceEnabled && matchedOrders.length > 0 && (
					<section class="card">
						<div class="card__head">
							<div>
								<h2 class="card__title">سفارش‌ها</h2>
								<p class="card__hint">{faNumber(matchedOrders.length)} نتیجه {(matchedOrders.length > resultLimit) && <a href={`/cms/orders?${searchParam}`}>— نمایش همه در فهرست</a>}</p>
							</div>
							<Icon name="receipt" size={18} />
						</div>
						<div class="table-wrap">
							<table class="table">
								<tbody>
									{matchedOrders.slice(0, resultLimit).map((order) => (
										<tr>
											<td>
												<a class="table__title ltr" href={`/cms/orders/${order.id}`} dir="ltr">
													{order.number}
												</a>
												<span class="table__slug">{order.customerName}</span>
											</td>
											<td class="num nowrap">{faMoney(order.total, settings.currency)}</td>
											<td>
												<span class={`badge badge--${orderStatusTone(order.status)}`}>
													{orderStatusLabel(order.status)}
												</span>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}
			</div>
		)
	}
</CmsLayout>

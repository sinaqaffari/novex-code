---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publicImageSrc } from '../../lib/cms/public-image';
import { faDate, faNumber, faReadingTime } from '../../lib/cms/fa';
import { listPosts } from '../../lib/cms/posts';
import { hydrateCart, readCart } from '../../lib/commerce/cart';

export const prerender = false;

const query = (Astro.url.searchParams.get('q') ?? '').trim();
const activeTag = (Astro.url.searchParams.get('tag') ?? '').trim();

const cart = await hydrateCart(readCart(Astro.cookies));
const posts = (await listPosts())
	.filter((post) => !post.draft && post.id.endsWith('.md'))
	.filter((post) => (activeTag ? post.tags.includes(activeTag) : true))
	.filter((post) =>
		query
			? `${post.title} ${post.description}`.toLowerCase().includes(query.toLowerCase())
			: true,
	);

const tags = [...new Set((await listPosts()).flatMap((post) => post.tags))].slice(0, 12);
const [lead, ...rest] = posts;
---

<SiteLayout title="مجله" description="نوشته‌های تازه دربارهٔ محصول، طراحی و توسعه" cartCount={cart.count}>
	<section class="shop-hero">
		<span class="shop-hero__eyebrow">مجلهٔ نووکس‌کد</span>
		<h1>یادداشت‌هایی از تیم ما</h1>
		<p>
			تجربه‌های واقعی از ساخت محصول، نگهداری پنل مدیریت فارسی و هر چیزی که به کار شما
			می‌آید — بدون تعارف.
		</p>
	</section>

	<form method="get" class="toolbar" style="display:flex;gap:0.5rem;margin-bottom:1rem">
		<label class="sr-only" for="q">جست‌وجو در مجله</label>
		<input class="input" id="q" name="q" value={query} placeholder="جست‌وجو در نوشته‌ها…" />
		{activeTag && <input type="hidden" name="tag" value={activeTag} />}
		<button class="btn btn--outline" type="submit">جست‌وجو</button>
	</form>

	{tags.length > 0 && (
		<div class="tag-row">
			<a class="tag" href="/blog" aria-current={!activeTag ? 'page' : undefined}>همه</a>
			{tags.map((tag) => (
				<a
					class="tag"
					href={`/blog?tag=${encodeURIComponent(tag)}`}
					aria-current={activeTag === tag ? 'page' : undefined}
				>{tag}</a>
			))}
		</div>
	)}

	{posts.length === 0 ? (
		<div class="empty">
			<h2>نوشته‌ای پیدا نشد</h2>
			<p>عبارت دیگری را جست‌وجو کنید یا همهٔ نوشته‌ها را ببینید.</p>
			<p style="margin-top:1rem"><a class="btn btn--outline" href="/blog">همهٔ نوشته‌ها</a></p>
		</div>
	) : (
		<div class="blog-layout">
			<a class="blog-lead" href={`/blog/${lead.slug}`}>
				<div class="blog-lead__media" aria-hidden="true">
					{publicImageSrc(lead.heroImage) ? <img src={publicImageSrc(lead.heroImage)} alt="" /> : <span>{lead.title.charAt(0)}</span>}
				</div>
				<div class="blog-lead__body">
					<span class="hint num">
						{faDate(lead.pubDate)} — {faReadingTime(lead.words)}
					</span>
					<h2>{lead.title}</h2>
					<p class="shop-card__desc" style="-webkit-line-clamp:3">{lead.description}</p>
					<span class="btn btn--outline" style="align-self:flex-start">ادامهٔ مطلب</span>
				</div>
			</a>

			<div class="blog-list">
				{rest.map((post) => (
					<a class="blog-item" href={`/blog/${post.slug}`}>
						<div class="blog-item__media" aria-hidden="true">
							{publicImageSrc(post.heroImage) ? <img src={publicImageSrc(post.heroImage)} alt="" /> : <span>{post.title.charAt(0)}</span>}
						</div>
						<div>
							<span class="hint num">{faDate(post.pubDate)} — {faReadingTime(post.words)}</span>
							<h3>{post.title}</h3>
							<p class="shop-card__desc">{post.description}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	)}

	<p class="hint" style="padding-bottom:2rem">
		{faNumber(posts.length)} نوشته در این فهرست — نوشته‌های تازه از پنل مدیریت منتشر می‌شوند.
	</p>
</SiteLayout>

---
import { marked } from 'marked';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publicImageSrc } from '../../lib/cms/public-image';
import { faDate, faNumber, faReadingTime } from '../../lib/cms/fa';
import { getPostDraft, listPosts } from '../../lib/cms/posts';
import { hydrateCart, readCart } from '../../lib/commerce/cart';
import { readSettings } from '../../lib/cms/settings';

export const prerender = false;
marked.setOptions({ gfm: true, breaks: false });

const { slug = '' } = Astro.params;
const posts = await listPosts();
const summary = posts.find((post) => post.slug === slug && !post.draft && post.id.endsWith('.md'));

if (!summary) {
	return new Response(
		`<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><title>نوشته پیدا نشد</title></head><body style="font-family:Tahoma;padding:3rem;text-align:center"><h1>نوشته پیدا نشد</h1><p><a href="/blog">بازگشت به مجله</a></p></body></html>`,
		{ status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } },
	);
}

const [draft, settings, cart] = await Promise.all([
	getPostDraft(summary.id),
	readSettings(),
	hydrateCart(readCart(Astro.cookies)),
]);

const html = await marked.parse(draft.body);
const related = posts
	.filter((post) => post.id !== summary.id && !post.draft && post.tags.some((tag) => summary.tags.includes(tag)))
	.slice(0, 2);
---

<SiteLayout
	title={draft.title}
	description={draft.description}
	cartCount={cart.count}
	type="article"
	image={publicImageSrc(draft.heroImage)}
	publishedAt={draft.pubDate}
>
	<article class="article">
		<nav class="breadcrumbs" aria-label="مسیر">
			<a href="/">خانه</a>
			<span aria-hidden="true">/</span>
			<a href="/blog">مجله</a>
			<span aria-hidden="true">/</span>
			<span>{draft.title}</span>
		</nav>

		<header class="article__head">
			<div class="tag-row" style="margin-bottom:0.6rem">
				{draft.tags.map((tag) => <a class="tag" href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
			</div>
			<h1>{draft.title}</h1>
			<p class="article__meta num">
				{faDate(draft.pubDate)}
				{draft.updatedDate && ` — آخرین ویرایش ${faDate(draft.updatedDate)}`}
				{` — ${faReadingTime(summary.words)}`}
				{settings.showAuthor && ` — ${settings.authorName}`}
			</p>
			{draft.description && <p class="article__lede">{draft.description}</p>}
			{publicImageSrc(draft.heroImage) && (
				<img class="article__hero" src={publicImageSrc(draft.heroImage)} alt={draft.title} />
			)}
		</header>

		<div class="prose" set:html={html} />

		<footer class="article__foot">
			<span class="hint num">{faNumber(summary.words)} واژه</span>
			<a class="btn btn--outline" href="/blog">بازگشت به مجله</a>
		</footer>
	</article>

	{related.length > 0 && (
		<section class="shop-section">
			<div class="shop-section__head">
				<h2>مطالب مرتبط</h2>
			</div>
			<div class="shop-grid">
				{related.map((post) => (
					<a class="shop-card" href={`/blog/${post.slug}`}>
						<div class="shop-card__body">
							<span class="hint num">{faDate(post.pubDate)}</span>
							<span class="shop-card__name">{post.title}</span>
							<p class="shop-card__desc">{post.description}</p>
						</div>
					</a>
				))}
			</div>
		</section>
	)}
</SiteLayout>

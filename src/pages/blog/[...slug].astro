---
import ShopLayout from '../../layouts/ShopLayout.astro';
import BlogPreview from '../../components/store/BlogPreview.astro';
import { publicImageSrc } from '../../lib/cms/public-image';
import { faDate, faReadingTime } from '../../lib/cms/fa';
import { getPostDraft, listPosts } from '../../lib/cms/posts';
import { hydrateCart, readCart } from '../../lib/commerce/cart';
import { readSettings } from '../../lib/cms/settings';
import { renderMarkdown } from '../../lib/cms/markdown';

export const prerender = false;

const { slug = '' } = Astro.params;
const posts = await listPosts();
const summary = posts.find((post) => post.slug === slug && !post.draft && post.id.endsWith('.md'));

if (!summary) {
	return new Response(
		`<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>نوشته پیدا نشد</title><style>body{margin:0;background:#f7f8fa;color:#171a1f;font-family:Tahoma,sans-serif;line-height:1.8}.not-found{max-width:38rem;margin:12vh auto;padding:2rem;text-align:center;background:#fff;border:1px solid #e2e5e8;border-radius:12px}a{color:#2563eb}</style></head><body><main class="not-found"><h1>نوشته پیدا نشد</h1><p>این نوشته وجود ندارد یا دیگر منتشرشده نیست.</p><a href="/blog">بازگشت به مجله</a></main></body></html>`,
		{ status: 404, headers: { 'content-type': 'text/html; charset=utf-8' } },
	);
}

const [draft, settings, cart] = await Promise.all([
	getPostDraft(summary.id),
	readSettings(),
	hydrateCart(readCart(Astro.cookies)),
]);

const renderedHtml = await renderMarkdown(draft.body);
const toc: Array<{ level: number; text: string; id: string }> = [];
let headingNumber = 0;
const html = renderedHtml.replace(/<h([23])([^>]*)>([\s\S]*?)<\/h\1>/gi, (_heading, level: string, attributes: string, inner: string) => {
	headingNumber += 1;
	const id = `article-section-${headingNumber}`;
	const text = inner
		.replace(/<[^>]*>/g, '')
		.replace(/&amp;/g, '&')
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'")
		.trim();
	toc.push({ level: Number(level), text, id });
	return `<h${level}${attributes} id="${id}">${inner}</h${level}>`;
});

const related = posts
	.filter((post) => post.id !== summary.id && !post.draft && post.id.endsWith('.md') && post.tags.some((tag) => summary.tags.includes(tag)))
	.slice(0, 3);
const hasAuthor = settings.showAuthor === true;
const heroImage = publicImageSrc(draft.heroImage);
---

<ShopLayout
	title={draft.title}
	description={draft.description}
	cartCount={cart.count}
	settings={settings}
	type="article"
	image={heroImage || undefined}
	publishedAt={draft.pubDate}
>
	<nav class="breadcrumbs" aria-label="مسیر">
		<a href="/">خانه</a>
		<span aria-hidden="true">/</span>
		<a href="/blog">مجله</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">{draft.title}</span>
	</nav>

	<article class="article">
		<header class="article__head">
			{draft.tags.length > 0 && (
				<ul class="article__tags" aria-label="برچسب‌ها">
					{draft.tags.map((tag) => (
						<li><a href={`/blog?tag=${encodeURIComponent(tag)}`} class="article__tag">{tag}</a></li>
					))}
				</ul>
			)}
			<h1 class="article__title">{draft.title}</h1>
			<div class="article__meta">
				<time datetime={draft.pubDate}>{faDate(draft.pubDate)}</time>
				{draft.updatedDate && <span>ویرایش‌شده در {faDate(draft.updatedDate)}</span>}
				<span>{faReadingTime(summary.words)}</span>
				{hasAuthor && <span>{settings.authorName}</span>}
			</div>
			{draft.description && <p class="article__lede">{draft.description}</p>}
			{heroImage && (
				<figure class="article__hero">
					<img src={heroImage} alt={draft.title} loading="eager" decoding="async" />
				</figure>
			)}
		</header>

		<div class:list={['article__body', toc.length === 0 && 'article__body--without-toc']}>
			{toc.length > 0 && (
				<aside class="article__toc" aria-labelledby="article-toc-title">
					<h2 id="article-toc-title" class="article__toc__title">فهرست مطالب</h2>
					<ol class="article__toc__list">
						{toc.map((item) => (
							<li class={`article__toc__item article__toc__level-${item.level}`}>
								<a href={`#${item.id}`}>{item.text}</a>
							</li>
						))}
					</ol>
				</aside>
			)}
			<div class="article__content prose" set:html={html} />
		</div>
	</article>

	{related.length > 0 && (
		<section class="article__related" aria-labelledby="related-posts-title">
			<div class="article__related__head"><h2 id="related-posts-title">مطالب مرتبط</h2></div>
			<div class="article__related__grid">
				{related.map((post) => <BlogPreview post={post} />)}
			</div>
		</section>
	)}
</ShopLayout>

<style>
	.article {
		max-width: 100%;
		margin-block: var(--space-4) var(--space-8);
		padding: clamp(var(--space-4), 3vw, var(--space-8));
		border: 1px solid rgba(207, 218, 233, 0.9);
		border-radius: calc(var(--radius-lg) + 4px);
		background: var(--surface);
		box-shadow: 0 14px 38px rgba(31, 55, 92, 0.075);
		animation: store-enter 460ms cubic-bezier(0.2, 0.7, 0.25, 1) both;
	}

	.article__head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-3);
		margin-block-end: var(--space-6);
		padding: clamp(var(--space-4), 3vw, var(--space-8));
		border: 1px solid var(--brand-line);
		border-radius: var(--radius-lg);
		background:
			radial-gradient(ellipse at 90% 0%, rgba(37, 99, 235, 0.09), transparent 24rem),
			linear-gradient(135deg, #f0f5ff 0%, #ffffff 72%, #f2faf7 100%);
	}

	.article__tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.article__tag {
		font-size: var(--text-xs);
		font-weight: var(--font-weight-medium);
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-full);
		border: 1px solid var(--line);
		background: var(--surface-2);
		color: var(--ink-soft);
	}

	.article__title {
		max-width: min(100%, 58rem);
		font-size: clamp(var(--text-3xl), 4vw, 2.5rem);
		line-height: 1.35;
		text-wrap: balance;
		overflow-wrap: anywhere;
	}

	.article__meta {
		display: flex;
		align-items: baseline;
		gap: var(--space-3);
		font-size: var(--text-sm);
		color: var(--muted);
		flex-wrap: wrap;
	}

	.article__lede {
		max-width: 65ch;
		font-size: var(--text-lg);
		color: var(--ink-soft);
		line-height: var(--line-height-relaxed);
	}

	.article__hero {
		width: 100%;
		max-height: 25rem;
		aspect-ratio: 16 / 9;
		margin: var(--space-2) 0 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--surface-2);
	}

	.article__hero img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.article__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-6);
	}

	@media (min-width: 1025px) {
		.article__body:not(.article__body--without-toc) {
			grid-template-columns: minmax(14rem, 0.32fr) minmax(0, 1fr);
			gap: var(--space-8);
		}
	}

	.article__body--without-toc .article__content {
		width: 100%;
		max-width: 76ch;
		margin-inline: auto;
	}

	.article__toc {
		position: sticky;
		top: calc(var(--header-height) + var(--space-4));
		align-self: start;
		padding: var(--space-4);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: linear-gradient(145deg, var(--brand-soft), var(--surface) 72%);
		box-shadow: var(--shadow-sm);
	}

	.article__toc__title {
		font-size: var(--text-base);
		margin-block-end: var(--space-3);
	}

	.article__toc__list {
		list-style: decimal;
		padding-inline-start: 1.25rem;
		margin: 0;
		display: grid;
		gap: var(--space-2);
	}

	.article__toc__item {
		font-size: var(--text-sm);
		color: var(--muted);
	}

	.article__toc__level-3 {
		margin-inline-start: var(--space-3);
	}

	.article__toc__item a {
		color: var(--ink-soft);
	}

	.article__content {
		width: 100%;
		max-width: 76ch;
		min-width: 0;
		margin-inline: auto;
		font-size: var(--text-lg);
		line-height: 1.78;
		color: var(--ink);
	}

	.article__content h1,
	.article__content h2,
	.article__content h3,
	.article__content h4 {
		font-weight: var(--font-weight-bold);
		color: var(--ink);
		margin-block: var(--space-6) var(--space-2);
		line-height: 1.45;
		scroll-margin-block-start: 6rem;
	}

	.article__content h1 { font-size: var(--text-2xl); }
	.article__content h2 { font-size: var(--text-xl); }
	.article__content h3 { font-size: var(--text-lg); }
	.article__content h4 { font-size: var(--text-base); }

	.article__content p { margin-block-end: var(--space-4); }
	.article__content a { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }
	.article__content ul,
	.article__content ol { margin-block-end: var(--space-4); padding-inline-end: 1.5rem; }
	.article__content li { margin-block-end: 0.5rem; }

	.article__content blockquote {
		border-inline-start: 3px solid var(--brand-line);
		padding-inline-start: var(--space-4);
		margin-block: var(--space-4);
		color: var(--ink-soft);
	}

	.article__content pre {
		background: #0f172a;
		border: 1px solid #1e293b;
		border-radius: var(--radius);
		padding: var(--space-4);
		overflow-x: auto;
		margin-block-end: var(--space-4);
	}

	.article__content pre code {
		background: transparent;
		border: 0;
		padding: 0;
		color: #e2e8f0;
		font-family: var(--font-mono);
		direction: ltr;
		unicode-bidi: isolate;
	}

	.article__content code:not(pre code) {
		direction: ltr;
		unicode-bidi: isolate;
		font-family: var(--font-mono);
	}

	.article__related {
		margin-block: var(--space-10) var(--space-8);
		padding-block-start: var(--space-6);
		border-block-start: 1px solid var(--line);
	}

	.article__related__head {
		margin-block-end: var(--space-4);
	}

	.article__related__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: var(--space-4);
	}

	@media (max-width: 640px) {
		.article__content {
			font-size: var(--text-base);
		}

		.article__body {
			gap: var(--space-4);
		}

		.article__toc {
			position: static;
			padding: var(--space-3);
		}

		.article__toc__title {
			margin-block-end: var(--space-2);
		}

		.article__toc__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2) var(--space-3);
		}
	}
</style>

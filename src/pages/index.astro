---
import ShopLayout from '../layouts/ShopLayout.astro';
import ProductCard from '../components/store/ProductCard.astro';
import { readSettings } from '../lib/cms/settings';
import { hydrateCart, readCart } from '../lib/commerce/cart';
import { listProducts } from '../lib/commerce/products';
import { faDate, faNumber, faReadingTime } from '../lib/cms/fa';
import { listPosts } from '../lib/cms/posts';

export const prerender = false;

const settings = await readSettings();
const [currentCart, publishedPosts, products] = await Promise.all([
	hydrateCart(readCart(Astro.cookies)),
	listPosts(),
	settings.commerceEnabled ? listProducts({ status: 'active', perPage: 8 }) : Promise.resolve({ items: [], counts: { active: 0 } }),
]);
const posts = publishedPosts.filter((post) => !post.draft && post.id.endsWith('.md'));
const featuredProducts = products.items.filter((product) => product.featured);
const visibleProducts = (featuredProducts.length ? featuredProducts : products.items).slice(0, 4);
const categories = [...new Set(products.items.map((product) => product.category))].slice(0, 6);
const latestPost = posts[0];
const recentPosts = posts.slice(1, 3);
const hasCommerce = settings.commerceEnabled && products.counts.active > 0;
---

<ShopLayout title={settings.siteTitle} description={settings.siteDescription} cartCount={currentCart.count} settings={settings}>
	<section class="hero home-hero" aria-labelledby="home-title">
		<div class:list={['hero__inner', latestPost && 'hero__inner--with-feature']}>
			<div class="home-hero__copy">
				<span class="hero__eyebrow">
					{visibleProducts.length > 0 ? 'مجله و فروشگاه' : 'مجلهٔ فنی نووکس‌کد'}
				</span>
				<h1 id="home-title" class="hero__title">
					{settings.heroTitle || settings.siteTitle}
				</h1>
				<p class="hero__desc">
					{settings.heroSubtitle || settings.siteDescription}
				</p>
				<div class="hero__actions">
					{visibleProducts.length > 0 && <a class="btn btn--primary btn--lg" href="/shop">دیدن محصولات</a>}
					<a class:list={['btn btn--lg', visibleProducts.length > 0 ? 'btn--outline' : 'btn--primary']} href="/blog">
						خواندن راهنماها
					</a>
				</div>
			</div>

			{latestPost && (
				<aside class="home-hero__latest" aria-labelledby="latest-post-title">
					<div class="home-hero__latest-copy">
						<div class="home-hero__latest-kicker">
							<span class="home-hero__latest-label">تازه در مجله</span>
							{latestPost.tags[0] && <span class="home-hero__latest-tag">{latestPost.tags[0]}</span>}
						</div>
						<h2 id="latest-post-title">
							<a href={`/blog/${latestPost.slug}`}>{latestPost.title}</a>
						</h2>
						{latestPost.description && <p>{latestPost.description}</p>}
					</div>
					<div class="home-hero__latest-meta">
						<time datetime={latestPost.pubDate}>{faDate(latestPost.pubDate)}</time>
						<span>{faReadingTime(latestPost.words)}</span>
					</div>
				</aside>
			)}
		</div>
	</section>

	{hasCommerce && (
		<section class="section" aria-labelledby="products-title">
			<div class="section__head">
				<div>
					<h2 id="products-title">محصولات فروشگاه</h2>
					<p class="section__subtitle">{faNumber(products.counts.active)} محصول منتشرشده</p>
				</div>
				<a class="section__subtitle" href="/shop">همهٔ محصولات</a>
			</div>

			{categories.length > 0 && (
				<nav class="category-nav" aria-label="دسته‌بندی محصولات">
					{categories.map((category) => (
						<a class="category-chip" href={`/shop?category=${encodeURIComponent(category)}`}>
							{category}
						</a>
					))}
				</nav>
			)}

			<div class="product-grid">
				{visibleProducts.map((product) => <ProductCard product={product} currency={settings.currency} />)}
			</div>
		</section>
	)}

	{recentPosts.length > 0 && (
		<section class="section" aria-labelledby="posts-title">
			<div class="section__head">
				<div>
					<h2 id="posts-title">از نوشته‌های دیگر</h2>
					<p class="section__subtitle">{faNumber(recentPosts.length)} راهنمای فنی منتشرشده</p>
				</div>
				<a class="section__subtitle" href="/blog">همهٔ نوشته‌ها</a>
			</div>

			<div class="resources-grid">
				{recentPosts.map((post) => (
					<a class="resource-card" href={`/blog/${post.slug}`}>
						{post.tags[0] && <span class="resource__tag">{post.tags[0]}</span>}
						<h3 class="resource__title">{post.title}</h3>
						{post.description && <p class="resource__desc">{post.description}</p>}
						<span class="hint">
							<time datetime={post.pubDate}>{faDate(post.pubDate)}</time> — {faReadingTime(post.words)}
						</span>
					</a>
				))}
			</div>
		</section>
	)}
</ShopLayout>

<style>
	@media (min-width: 960px) {
		.hero__inner:not(.hero__inner--with-feature) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.home-hero {
		padding-block: clamp(1.5rem, 4vw, 2.75rem);
	}

	.home-hero .hero__inner {
		gap: var(--space-6);
	}

	.home-hero__copy {
		min-width: 0;
	}

	.home-hero__latest {
		align-self: start;
		width: 100%;
		max-width: 52rem;
		min-width: 0;
		justify-self: start;
		padding: clamp(1rem, 2.5vw, 1.5rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(8rem, 0.35fr);
		align-items: center;
		gap: var(--space-4);
	}

	.home-hero__latest-copy {
		min-width: 0;
		display: grid;
		align-content: start;
		gap: var(--space-2);
	}

	.home-hero__latest-kicker {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.home-hero__latest-label,
	.home-hero__latest-tag {
		width: fit-content;
		font-size: var(--text-xs);
		font-weight: var(--font-weight-semibold);
		color: var(--brand-ink);
	}

	.home-hero__latest-tag {
		padding: 0.2rem 0.65rem;
		border: 1px solid var(--brand-line);
		border-radius: var(--radius-full);
		background: var(--brand-soft);
	}

	.home-hero__latest h2 {
		font-size: clamp(var(--text-lg), 2vw, var(--text-2xl));
		line-height: 1.45;
	}

	.home-hero__latest h2 a {
		color: var(--ink);
	}

	.home-hero__latest p {
		color: var(--ink-soft);
		font-size: var(--text-sm);
		line-height: var(--line-height-relaxed);
	}

	.home-hero__latest-meta {
		grid-column: 2;
		grid-row: 1;
		align-self: stretch;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: var(--space-2);
		min-width: 0;
		padding-inline-start: var(--space-4);
		border-inline-start: 1px solid var(--line);
		color: var(--muted);
		font-size: var(--text-sm);
	}

	.home-hero__latest-meta > * {
		max-width: 100%;
		overflow-wrap: anywhere;
	}

	.section__head > div {
		display: grid;
		gap: var(--space-1);
	}

	.resource__tag {
		font-size: var(--text-xs);
		font-weight: var(--font-weight-semibold);
		color: var(--brand-ink);
	}

	@media (max-width: 640px) {
		.home-hero__latest {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
			padding: var(--space-4);
		}

		.home-hero__latest-meta {
			grid-column: 1;
			grid-row: auto;
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			justify-content: flex-start;
			padding-block-start: var(--space-3);
			padding-inline-start: 0;
			border-block-start: 1px solid var(--line);
			border-inline-start: 0;
		}
	}
</style>

---
import ShopLayout from '../../layouts/ShopLayout.astro';
import '../../styles/commerce.css';
import '../../styles/catalog.css';
import '../../styles/marketplace.css';
import ProductCard from '../../components/store/ProductCard.astro';
import ProductArtwork from '../../components/store/ProductArtwork.astro';
import TemplateCard from '../../components/store/TemplateCard.astro';
import { requestCommerce, requestSettings } from '../../lib/cms/request-data';
import { createEmptyDatabase } from '../../lib/commerce/db';
import { hydrateCart, readCart } from '../../lib/commerce/cart';
import { listProducts, parseProductSort } from '../../lib/commerce/products';
import { listCatalogTemplates } from '../../lib/builder/template-catalog';
import { faMoney, faNumber } from '../../lib/cms/fa';

export const prerender = false;

const settings = await requestSettings(Astro.locals);
const shopClosed = !settings.commerceEnabled;
const snapshot = shopClosed ? createEmptyDatabase() : await requestCommerce(Astro.locals);
const cart = shopClosed ? { count: 0 } : await hydrateCart(readCart(Astro.cookies), snapshot);
const query = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 200);
const category = (Astro.url.searchParams.get('category') ?? '').trim().slice(0, 60);
const sort = parseProductSort(Astro.url.searchParams.get('sort')?.trim());
const pageInput = Number(Astro.url.searchParams.get('page'));
const requestedPage = Number.isSafeInteger(pageInput) ? Math.max(1, pageInput) : 1;
const result = await listProducts({ query, status: 'active', category, sort, page: requestedPage, perPage: 12 }, snapshot);
const hasActiveProducts = result.counts.active > 0;
const products = result.items;
const allCategories = result.categories;
const featured = !query && !category ? (products.find((product) => product.featured) ?? products[0]) : undefined;
const templates = listCatalogTemplates().slice(0, 4);
const sortOptions: Array<{ value: string; label: string }> = [
	{ value: 'newest', label: 'تازه‌ترین' },
	{ value: 'price-asc', label: 'قیمت: کم به زیاد' },
	{ value: 'price-desc', label: 'قیمت: زیاد به کم' },
	{ value: 'stock-asc', label: 'موجودی: کم به زیاد' },
	{ value: 'name', label: 'نام: الفبا' },
];
function catalogUrl(changes: Record<string, string | null> = {}): string {
	const params = new URLSearchParams(Astro.url.searchParams);
	for (const [key, value] of Object.entries(changes)) value === null ? params.delete(key) : params.set(key, value);
	params.delete('page');
	const search = params.toString();
	return search ? `/shop?${search}` : '/shop';
}
function paginationUrl(page: number): string {
	const params = new URLSearchParams(Astro.url.searchParams);
	params.set('page', String(page));
	return `/shop?${params.toString()}`;
}
const pageNumbers = [...new Set([1, result.page - 1, result.page, result.page + 1, result.pages].filter((page) => page >= 1 && page <= result.pages))].sort((a, b) => a - b);
---

<ShopLayout title={settings.shopTitle || 'فروشگاه'} description={settings.shopDescription} cartCount={cart.count} settings={settings}>
	<nav class="breadcrumbs catalog-breadcrumbs" aria-label="مسیر"><a href="/">خانه</a><span aria-hidden="true">/</span><span aria-current="page">فروشگاه</span></nav>

	<section class="catalog-hero" aria-labelledby="catalog-title">
		<div class="catalog-hero__copy"><span class="catalog-hero__eyebrow">فروشگاه نووکس</span><h1 id="catalog-title">{settings.shopTitle || 'فروشگاه'}</h1><p>{settings.shopDescription || 'محصولات منتشرشده را پیدا کنید و جزئیات، قیمت و موجودی آن‌ها را ببینید.'}</p><div class="catalog-hero__links">{!shopClosed && hasActiveProducts && <a href="#catalog-products">مرور محصولات <span aria-hidden="true">←</span></a>}<a href="/marketplace">دیدن طرح‌های آماده <span aria-hidden="true">↗</span></a></div></div>
		{featured ? <a class="catalog-hero__feature" href={`/shop/${featured.slug}`}><div class="catalog-hero__feature-image"><ProductArtwork product={featured} /></div><div><span>{featured.featured ? 'محصول منتخب' : 'از فروشگاه'}</span><strong>{featured.name}</strong><small>{faMoney(featured.price, settings.currency)} · {featured.stock > 0 ? 'موجود' : 'ناموجود'}</small></div></a> : <div class="catalog-hero__info"><span>برای ساخت صفحهٔ بعدی</span><strong>از طرح‌های آماده شروع کنید.</strong><p>طرح‌ها در صفحه‌ساز بومی قابل ویرایش‌اند.</p><a href="/marketplace">رفتن به بازار قالب‌ها ←</a></div>}
	</section>

	{shopClosed ? (
		<div class="empty catalog-empty" role="status"><h2 class="empty__title">فروشگاه غیرفعال است</h2><p class="empty__desc">در حال حاضر امکان مشاهده و خرید محصولات وجود ندارد.</p><a class="btn btn--outline" href="/blog">رفتن به مجله</a></div>
	) : !hasActiveProducts ? (
		<div class="empty catalog-empty" role="status"><h2 class="empty__title">هنوز محصول فعالی ثبت نشده است</h2><p class="empty__desc">محصولات منتشرشده در این صفحه نمایش داده می‌شوند.</p><div class="catalog-empty__actions"><a class="btn btn--primary" href="/cms/products/new">افزودن محصول در پنل</a><a class="btn btn--outline" href="/blog">خواندن نوشته‌های مجله</a></div></div>
	) : (
		<section class="catalog-section" id="catalog-products" aria-labelledby="catalog-products-title">
			<div class="catalog-section__head"><div><span>محصولات فروشگاه</span><h2 id="catalog-products-title">همهٔ محصولات</h2><p>{faNumber(result.total)} محصول{query && ` برای «${query}»`}</p></div><a href="/shop/track">پیگیری سفارش ←</a></div>
			<div class="catalog-toolbar">
				<div class="catalog-search"><form action="/shop" method="get" role="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg><label class="sr-only" for="catalog-q">جست‌وجو در محصولات</label><input id="catalog-q" type="search" name="q" value={query} placeholder="جست‌وجو در محصولات…" dir="auto" />{category && <input type="hidden" name="category" value={category} />}{sort !== 'newest' && <input type="hidden" name="sort" value={sort} />}<button class="catalog-search__submit" type="submit">جست‌وجو</button></form></div>
				<div class="catalog-sort"><form class="catalog-sort-form" action="/shop" method="get"><label for="sortSelect">مرتب‌سازی</label><select id="sortSelect" name="sort">{sortOptions.map((option) => <option value={option.value} selected={option.value === sort}>{option.label}</option>)}</select>{query && <input type="hidden" name="q" value={query} />}{category && <input type="hidden" name="category" value={category} />}<button type="submit" class="btn btn--sm btn--primary">اعمال</button></form></div>
			</div>
			{(allCategories.length > 0 || query || category) && <nav class="catalog-filters" aria-label="فیلتر محصولات"><a href={catalogUrl({ category: null })} class:list={['filter-chip', !category && 'filter-chip--active']} aria-current={!category ? 'page' : undefined}>همه</a>{allCategories.map((cat) => <a href={catalogUrl({ category: category === cat ? null : cat })} class:list={['filter-chip', category === cat && 'filter-chip--active']} aria-current={category === cat ? 'page' : undefined}>{cat}</a>)}{query && <a href={catalogUrl({ q: null })} class="filter-chip filter-chip--active">«{query}» <span aria-hidden="true">×</span></a>}{(category || query) && <a href="/shop" class="reset-filters">پاک‌کردن فیلترها</a>}</nav>}
			<p class="catalog__count num">{faNumber(result.total)} محصول</p>
			{products.length ? <div class="product-grid">{products.map((product) => <ProductCard product={product} currency={settings.currency} />)}</div> : <div class="empty catalog-empty" role="status"><h3 class="empty__title">محصولی با این فیلترها پیدا نشد</h3><p class="empty__desc">عبارت جست‌وجو یا دسته‌بندی را تغییر دهید.</p><a class="btn btn--outline" href="/shop">پاک‌کردن فیلترها</a></div>}
			{result.pages > 1 && <nav class="pagination" aria-label="صفحه‌بندی">{result.page > 1 && <a class="btn btn--outline btn--sm" href={paginationUrl(result.page - 1)}>صفحهٔ قبل</a>}{pageNumbers.map((pageNumber, index) => <>{index > 0 && pageNumber > pageNumbers[index - 1] + 1 && <span aria-hidden="true">…</span>}<a class:list={['btn', 'btn--sm', pageNumber === result.page ? 'btn--primary' : 'btn--outline']} href={paginationUrl(pageNumber)} aria-current={pageNumber === result.page ? 'page' : undefined}>{faNumber(pageNumber)}</a></>)}{result.page < result.pages && <a class="btn btn--outline btn--sm" href={paginationUrl(result.page + 1)}>صفحهٔ بعد</a>}</nav>}
		</section>
	)}
	<section class="market-section catalog-templates" aria-labelledby="catalog-templates-title"><div class="market-section__head"><div><h2 id="catalog-templates-title">به دنبال طرح برای سایت هستید؟</h2><p>صفحه‌های آمادهٔ بومی را پیش‌نمایش کنید و در صفحه‌ساز تغییر دهید.</p></div><a href="/marketplace">همهٔ طرح‌ها ←</a></div><div class="market-grid">{templates.map((template) => <TemplateCard template={template} />)}</div></section>
</ShopLayout>

		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/vazirmatn": "^5.3.0",
		"@playwright/browser-chromium": "^1.64.1",
		"astro": "^7.4.2",
		"entities": "^6.0.1",
		"fast-xml-parser": "^5.11.2",
		"htmlparser2": "^10.0.0",
		"marked": "^18.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sharp": "^0.35.0",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@emnapi/runtime": "^1.11.3",
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"typescript": "^6.0.3",
		"wabt": "^1.0.39",
		"yazl": "^3.3.1"
	}

{
	"name": "novex-code-clean",
	"type": "module",
	"version": "0.1.1",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check:rtl": "node scripts/check-rtl.mjs",
		"check:copy": "node scripts/check-copy.mjs",
		"check": "astro check",
		"seed:demo": "node scripts/seed-demo.mjs",
		"test": "node --experimental-strip-types --test tests/*.test.ts tests/e2e/*.test.ts",
		"test:e2e": "npm run build && node scripts/run-e2e.mjs",
		"test:ci": "npm run check && npm run build && npm test",
		"docker:build": "docker build -t novex-code .",
		"docker:up": "docker compose up --build -d",
		"docker:down": "docker compose down"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.1",
		"@astrojs/node": "^11.1.9",
		"@astrojs/react": "^7.1.2",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/vazirmatn": "^5.3.0",
		"@playwright/browser-chromium": "^1.64.1",
		"astro": "^7.4.2",
		"fast-xml-parser": "^5.11.2",
		"marked": "^18.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sharp": "^0.35.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@emnapi/runtime": "^1.11.3",
		"@playwright/test": "^1.64.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^6.0.3"
	}
}

{
	"name": "novex-code-clean",
	"type": "module",
	"version": "0.1.1",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check:rtl": "node scripts/check-rtl.mjs",
		"check:copy": "node scripts/check-copy.mjs",
		"check": "astro check",
		"seed:demo": "node scripts/seed-demo.mjs",
		"test": "node scripts/run-tests.mjs",
		"test:e2e": "npm run build && node scripts/run-e2e.mjs",
		"test:ci": "npm run check && npm run build && npm test",
		"docker:build": "docker build -t novex-code .",
		"docker:up": "docker compose up --build -d",
		"docker:down": "docker compose down",
		"docker:fullstack": "node scripts/fullstack-compose.mjs up",
		"dev:fullstack": "node scripts/fullstack-compose.mjs dev",
		"commerce:migrate": "node scripts/fullstack-compose.mjs migrate-commerce",
		"commerce:export": "node scripts/fullstack-compose.mjs export-commerce",
		"builder:migrate": "node scripts/fullstack-compose.mjs migrate-builder",
		"builder:export": "node scripts/fullstack-compose.mjs export-builder",
		"docker:builder:migrate": "node scripts/fullstack-compose.mjs docker-migrate-builder",
		"docker:builder:export": "node scripts/fullstack-compose.mjs docker-export-builder",
		"docker:commerce:migrate": "node scripts/fullstack-compose.mjs docker-migrate-commerce",
		"docker:commerce:export": "node scripts/fullstack-compose.mjs docker-export-commerce",
		"docker:fullstack:down": "node scripts/fullstack-compose.mjs down",
		"test:backend": "go -C backend test ./..."
	},
	"dependencies": {
		"@astrojs/mdx": "^8.1.1",
		"@astrojs/node": "^11.1.9",
		"@astrojs/react": "^7.1.2",

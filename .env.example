# ── پنل مدیریت (‎/cms‎) ─────────────────────────────────────────────
# نام کاربری مدیر
CMS_USERNAME=admin

# گذرواژهٔ ساده — فقط برای توسعهٔ محلی
CMS_PASSWORD=novex-admin

# در محیط عملیاتی به‌جای گذرواژهٔ ساده از هش scrypt استفاده کنید. برای ساخت هش:
#   node --input-type=module -e "import {scryptSync,randomBytes} from 'node:crypto';const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync('گذرواژهٔ-شما',s,64).toString('hex'))"
# CMS_PASSWORD_HASH=scrypt:<salt>:<hash>

# کلید امضای نشست (۶۴ کاراکتر تصادفی). اگر تنظیم نشود، با هر بار راه‌اندازی
# یک کلید موقت ساخته می‌شود و نشست‌ها باطل می‌شوند.
# CMS_SESSION_SECRET=

# کلید اختصاصی اختیاری برای امضای کوکی دسترسی به سفارش؛ در نبود آن از CMS_SESSION_SECRET استفاده می‌شود.
# NOVEX_ORDER_ACCESS_SECRET=

# اگر پنل را بدون HTTPS اجرا می‌کنید و NODE_ENV=production است، این را false بگذارید.
# CMS_COOKIE_SECURE=false

# ── اجرا و Docker ────────────────────────────────────────────────
# مسیر فایل اصلی/نشانگر فروشگاه؛ پیش‌فرض data/commerce.json و قفل مشترک روی یک فایل‌سیستم است.
# COMMERCE_DB_FILE=/var/lib/novex/commerce.json

# نشانی عمومی HTTPS سایت — برای canonical/og:url و callback پرداخت لازم است.
# SITE_URL=https://shop.example

# رازهای افزونه از secret manager محیط استقرار تزریق می‌شوند و در data/plugins.json نمی‌روند.
# هرگز مقدار واقعی را در این فایل نمونه یا در Git قرار ندهید.
# NOVEX_PLUGIN_KAVEH_NEG_SMS_API_KEY=
# NOVEX_PLUGIN_ZARINPAL_GATEWAY_MERCHANT_ID=

# پورت سرور (در compose به همان پورت میزبان نگاشت می‌شود)
# PORT=4321
# منطقهٔ زمانی سرور
# TZ=Asia/Tehran

# ── سرویس فرم‌های قالب (اجرای اختیاری Go + PostgreSQL) ────────────
# `npm run dev:fullstack` سرویس‌ها را در Docker و Astro را با فایل‌های محلی فعلی اجرا می‌کند.
# `npm run docker:fullstack` همهٔ برنامه را در Docker و والیوم‌های مستقل اجرا می‌کند. رازها جداگانه نگهداری می‌شوند.
# برای اجرای دستی، نشانی داخلی سرویس و یک کلید تصادفی مشترک (حداقل ۳۲ نویسه) را تنظیم کنید.
# NOVEX_BACKEND_URL=http://127.0.0.1:8080
# NOVEX_BACKEND_TOKEN=
# سمت Go: DATABASE_URL یا PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD, PGSSLMODE

# در صورت نیاز پورت محلی سرویس را تغییر دهید؛ فقط روی 127.0.0.1 منتشر می‌شود.
# NOVEX_BACKEND_PORT=8081
# NOVEX_DEV_HOST=127.0.0.1

# مخزن فروشگاه پیش‌فرض فایل فعلی است. PostgreSQL فقط پس از انتقال صریح و آفلاین فعال می‌شود.
# COMMERCE_DB_FILE=/absolute/path/to/commerce.json
# درخواست ذخیرهٔ کامل فروشگاه حداکثر ۱۵ MiB است.
# همهٔ فرایندها باید قفل و فایل‌های رسانهٔ مشترک داشته باشند؛ این حالت قفل توزیع‌شده نیست.
# NOVEX_COMMERCE_STORE=postgres

# سندها، انتشار، قالب‌ها، بخش‌ها و بسته‌های داده‌محور صفحه‌ساز مخزن جداگانه دارند.
# ابتدا همهٔ برنامه‌ها را متوقف و از داده‌ها نسخهٔ پشتیبان بگیرید؛ سپس انتقال صریح انجام دهید.
# BUILDER_DATA_FILE=/absolute/path/to/builder-pages.json
# NOVEX_BUILDER_STORE=postgres

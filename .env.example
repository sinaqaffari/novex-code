# ── پنل مدیریت (‎/cms‎) ─────────────────────────────────────────────
# نام کاربری مدیر
CMS_USERNAME=admin

# گذرواژهٔ ساده — فقط برای توسعهٔ محلی
CMS_PASSWORD=novex-admin

# در محیط عملیاتی به‌جای گذرواژهٔ ساده از هش scrypt استفاده کنید. برای ساخت هش:
#   node --input-type=module -e "import {scryptSync,randomBytes} from 'node:crypto';const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync('گذرواژهٔ-شما',s,64).toString('hex'))"
# CMS_PASSWORD_HASH=scrypt:<salt>:<hash>

# کلید امضای نشست (۶۴ کاراکتر تصادفی). اگر تنظیم نشود، با هر بار راه‌اندازی
# یک کلید موقت ساخته می‌شود و نشست‌ها باطل می‌شوند.
# CMS_SESSION_SECRET=

# اگر پنل را بدون HTTPS اجرا می‌کنید و NODE_ENV=production است، این را false بگذارید.
# CMS_COOKIE_SECURE=false

# ── اجرا و Docker ────────────────────────────────────────────────
# نشانی عمومی سایت — در canonical، og:url و فید RSS استفاده می‌شود.
# SITE_URL=https://novex.example

# پورت سرور (در compose به همان پورت میزبان نگاشت می‌شود)
# PORT=4321
# منطقهٔ زمانی سرور
# TZ=Asia/Tehran

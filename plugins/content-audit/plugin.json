			"key": "includeDrafts",
			"label": "پیش‌نویس‌ها هم بررسی شوند",
			"type": "switch",
			"default": true,
			"help": "اگر خاموش باشد فقط نوشته‌های منتشرشده بررسی می‌شوند."
